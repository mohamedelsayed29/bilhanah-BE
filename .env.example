NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://bilhanah:bilhanah_dev_password@127.0.0.1:55432/bilhanah
REDIS_URL=redis://127.0.0.1:56379

# Dashboard origin(s) allowed to use the auth cookie.
CORS_ORIGINS=http://127.0.0.1:5174
DASHBOARD_URL=http://127.0.0.1:5174
# Points at the web dev server (apps/web), which renders {subdomain}.localhost.
RESTAURANT_URL_TEMPLATE=http://{subdomain}.localhost:5173

JWT_ACCESS_SECRET=change-me-to-a-random-string-of-32-plus-chars
# Sessions slide by REFRESH_TOKEN_TTL_DAYS on each use, up to SESSION_MAX_DAYS after sign-in.
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_DAYS=90

# Proxies allowed to set X-Forwarded-For: a hop count (1 behind one reverse proxy)
# or addresses/CIDRs. Wrong values make every client share one rate-limit bucket.
TRUST_PROXY=loopback

# Administrator sessions end this many hours after sign-in.
ADMIN_SESSION_HOURS=12
# Encrypts administrators' authenticator secrets (32+ characters). Optional locally:
# derived from JWT_ACCESS_SECRET when unset. Set it in production and never change it,
# or administrators must re-enroll (npm run admin:reset-mfa).
# DATA_ENCRYPTION_KEY=

# Uploaded images. Locally they go to var/media and are served by the API at /media.
# Production (Cloudflare R2): STORAGE_DRIVER=s3, S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com,
# S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, and MEDIA_PUBLIC_URL=https://media.bilhanah.com
STORAGE_DRIVER=local
MEDIA_PUBLIC_URL=http://127.0.0.1:3000/media

# Receives the website's contact form.
CONTACT_INBOX=hello@bilhanah.com

# Mailpit catches all mail: http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Bilhanah <no-reply@bilhanah.local>
