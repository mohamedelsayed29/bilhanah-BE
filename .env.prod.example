# Copy to infra/.env.prod on the server (chmod 600). Never commit the real file.
# Generate secrets with: openssl rand -hex 32

ROOT_DOMAIN=bilhanah.com
ACME_EMAIL=ops@bilhanah.com
TLS_MODE=cloudflare
# Cloudflare API token with Zone > DNS > Edit for the zone (wildcard certificate).
CLOUDFLARE_API_TOKEN=

POSTGRES_USER=bilhanah
POSTGRES_PASSWORD=
POSTGRES_DB=bilhanah

# --- API and worker (read by both) ---
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=https://app.bilhanah.com
DASHBOARD_URL=https://app.bilhanah.com
RESTAURANT_URL_TEMPLATE=https://{subdomain}.bilhanah.com
JWT_ACCESS_SECRET=

# Images: on this server (volume "media", served at https://api.bilhanah.com/media) ...
STORAGE_DRIVER=local
MEDIA_PUBLIC_URL=https://api.bilhanah.com/media
# ... or Cloudflare R2:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=bilhanah-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_URL=https://media.bilhanah.com

CONTACT_INBOX=hello@bilhanah.com
# Website contact details compiled into the site.
CONTACT_EMAIL=hello@bilhanah.com
CONTACT_WHATSAPP=

# Transactional email (Resend, Postmark, Amazon SES, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Bilhanah <no-reply@bilhanah.com>
