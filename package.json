{
  "name": "@bilhanah/backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "seed:demo": "node scripts/seed-demo.mjs",
    "postinstall": "npm run build:packages",
    "build:packages": "npm run build -w @bilhanah/contracts -w @bilhanah/database",
    "services:up": "docker compose -f infra/compose.dev.yml up -d --wait",
    "services:down": "docker compose -f infra/compose.dev.yml down",
    "db:deploy": "npm run migrate:deploy -w @bilhanah/database",
    "db:migrate": "npm run migrate:dev -w @bilhanah/database",
    "db:studio": "npm run studio -w @bilhanah/database",
    "contracts:sync": "bash scripts/sync-contracts.sh",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker:dev": "nest start --watch --entryFile worker --path tsconfig.build.worker.json",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "admin:create": "node dist/commands/create-admin.cli.js",
    "admin:reset-mfa": "node dist/commands/reset-admin-mfa.cli.js",
    "test:contracts": "npm test -w @bilhanah/contracts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@bilhanah/contracts": "0.1.0",
    "@bilhanah/database": "0.1.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.11",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bilhanah/config": "0.1.0",
    "@nestjs/cli": "12.0.9",
    "@nestjs/schematics": "12.0.9",
    "@nestjs/testing": "12.1.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "oxlint": "1.89.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
