generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  /// A restaurant's kitchen screen; created by its owner, sees and moves orders only.
  KITCHEN
  /// Runs one branch (or all, when not tied to one): orders, tables, its menu overrides and ordering switches.
  MANAGER
  /// Bills and payments: sees orders and tables, marks bills paid, completes orders.
  CASHIER
  /// Tables and guests: sees orders and tables, handles reservations and service requests.
  WAITER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum Language {
  ar
  en

  @@map("language")
}

enum SessionRevokedReason {
  LOGOUT
  REFRESH_TOKEN_REUSE
  PASSWORD_RESET
  PASSWORD_CHANGE
  /// Ended from the account's session list.
  REVOKED_BY_USER

  @@map("session_revoked_reason")
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED

  @@map("restaurant_status")
}

enum PlanCode {
  MENU
  ORDERS
  ADVANCED

  @@map("plan_code")
}

enum EntitlementKind {
  TRIAL
  PAID

  @@map("entitlement_kind")
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique
  /// Null when nobody may sign in with a password until the inbox owner sets one (see AuthService.register).
  passwordHash      String?    @map("password_hash")
  fullName          String     @map("full_name")
  preferredLanguage Language   @default(ar) @map("preferred_language")
  role              UserRole   @default(OWNER)
  /// Quick sign-in on a registered POS device (staff only): the PIN's hash, and brute-force protection.
  posPinHash           String?   @map("pos_pin_hash")
  posPinFailedAttempts Int       @default(0) @map("pos_pin_failed_attempts")
  posPinLockedUntil    DateTime? @map("pos_pin_locked_until") @db.Timestamptz(3)
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  /// Administrators only: TOTP secret, AES-256-GCM encrypted (see TotpService).
  totpSecret        String?    @map("totp_secret")
  /// Last accepted TOTP time step, so a code cannot be used twice.
  totpLastStep      Int?       @map("totp_last_step")
  /// Staff accounts (kitchen, manager) only: the restaurant they work for.
  staffRestaurantId String?    @map("staff_restaurant_id") @db.Uuid
  /// Staff accounts only: the branch they work at; null means every branch.
  staffBranchId     String?    @map("staff_branch_id") @db.Uuid
  /// Staff accounts only: extra permissions on top of the role's (see GRANTABLE_PERMISSIONS in contracts).
  permissionGrants  String[]   @default([]) @map("permission_grants")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                 Session[]
  identities               UserIdentity[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  restaurant               Restaurant?
  staffRestaurant          Restaurant?              @relation("RestaurantStaff", fields: [staffRestaurantId], references: [id], onDelete: Cascade)
  staffBranch              Branch?                  @relation("BranchStaff", fields: [staffBranchId], references: [id], onDelete: Cascade)
  reviewedPayments         SubscriptionPayment[]
  standOrderEvents         StandOrderEvent[]
  grantedEntitlements      Entitlement[]
  auditLogs                AuditLog[]
  assignedServiceRequests  ServiceRequest[]         @relation("ServiceRequestAssignee")
  handledServiceRequests   ServiceRequest[]         @relation("ServiceRequestHandler")
  orderStatusEvents        OrderStatusEvent[]
  orderTableTransfers      OrderTableTransfer[]
  orderItemEvents          OrderItemEvent[]
  employee                 Employee?
  attendanceReviews        AttendanceCorrection[]   @relation("AttendanceReviewer")
  cashShifts               CashShift[]              @relation("CashShiftCashier")
  closedCashShifts         CashShift[]              @relation("CashShiftCloser")
  reviewedCashShifts       CashShift[]              @relation("CashShiftReviewer")
  cashTransactions         CashTransaction[]        @relation("CashTransactionCreator")
  approvedCashTransactions CashTransaction[]        @relation("CashTransactionApprover")
  inventorySettingsChanges InventorySettings[]
  stockMovements           StockMovement[]
  createdPurchases         Purchase[]               @relation("PurchaseCreator")
  receivedPurchases        Purchase[]               @relation("PurchaseReceiver")
  voidedPurchases          Purchase[]               @relation("PurchaseVoider")
  wasteEntries             WasteEntry[]
  createdStockCounts       StockCount[]             @relation("StockCountCreator")
  postedStockCounts        StockCount[]             @relation("StockCountPoster")
  submittedStockCounts     StockCount[]             @relation("StockCountSubmitter")
  stockTransfers           StockTransfer[]
  reviewSettingsChanges    ReviewSettings[]
  reviewReplies            Review[]                 @relation("ReviewReplier")
  reviewModerations        Review[]                 @relation("ReviewModerator")
  reviewFollowUps          Review[]                 @relation("ReviewAssignee")
  reviewEvents             ReviewEvent[]            @relation("ReviewEventActor")
  reviewEventAssignments   ReviewEvent[]            @relation("ReviewEventAssignee")
  faqRevisions             FaqRevision[]            @relation("FaqRevisionEditor")
  faqInteractions          FaqInteraction[]         @relation("UserFaqInteractions")
  assistantSessions        AssistantSession[]       @relation("UserAssistantSessions")
  supportTickets           SupportTicket[]          @relation("SupportTicketRequester")
  assignedSupportTickets   SupportTicket[]          @relation("SupportTicketAssignee")
  supportMessages          SupportMessage[]         @relation("SupportMessageAuthor")
  supportAttachments       SupportAttachment[]      @relation("SupportAttachmentUploader")
  supportAssignments       SupportAssignment[]      @relation("SupportAssignmentAssignee")
  supportAssignmentsMade   SupportAssignment[]      @relation("SupportAssignmentAssigner")
  supportActivity          SupportTicketActivity[]  @relation("SupportActivityActor")
  supportNotifications     SupportNotification[]    @relation("SupportNotificationRecipient")

  @@index([staffRestaurantId])
  @@index([staffBranchId])
  @@map("users")
}

/// A refresh-token session. Only a hash of the current secret is stored; it rotates on every refresh.
model Session {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  tokenHash     String                @map("token_hash") @db.Char(64)
  expiresAt     DateTime              @map("expires_at") @db.Timestamptz(3)
  lastUsedAt    DateTime?             @map("last_used_at") @db.Timestamptz(3)
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz(3)
  revokedReason SessionRevokedReason? @map("revoked_reason")
  userAgent     String?               @map("user_agent") @db.VarChar(512)
  ipAddress     String?               @map("ip_address") @db.VarChar(64)
  /// "Keep me signed in": true for REMEMBER_ME_DAYS, false until the browser closes (at most a day), null for the standard sliding session.
  remember      Boolean?
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Restaurant {
  id                            String           @id @default(uuid()) @db.Uuid
  /// One restaurant per owner account.
  ownerId                       String           @unique @map("owner_id") @db.Uuid
  name                          String
  /// Permanent public address: {subdomain}.bilhanah.com
  subdomain                     String           @unique
  contactName                   String           @map("contact_name")
  phone                         String
  city                          String
  address                       String
  defaultLanguage               Language         @default(ar) @map("default_language")
  timezone                      String           @default("Africa/Cairo")
  /// Diners at a table can call a waiter or ask for the bill, water, ... from the menu.
  serviceRequestsEnabled        Boolean          @default(true) @map("service_requests_enabled")
  /// Throttling: a closed request of the same type cannot be repeated from a table for this long,
  /// and a table sends at most this many requests an hour.
  serviceRequestCooldownSeconds Int              @default(120) @map("service_request_cooldown_seconds")
  serviceRequestHourlyLimit     Int              @default(20) @map("service_request_hourly_limit")
  /// Shared table sessions: the guests at a scanned table build one order together.
  tableSessionsEnabled          Boolean          @default(true) @map("table_sessions_enabled")
  /// Guests may change and remove each other's unsent dishes (otherwise only their own).
  tableSessionSharedEditing     Boolean          @default(false) @map("table_session_shared_editing")
  /// Usual minutes from accepting an order to ready, shown to diners as an estimate; null shows none.
  orderPrepMinutes              Int?             @map("order_prep_minutes")
  whatsappNumber                String?          @map("whatsapp_number")
  websiteUrl                    String?          @map("website_url")
  facebookUrl                   String?          @map("facebook_url")
  instagramUrl                  String?          @map("instagram_url")
  status                        RestaurantStatus @default(ACTIVE)
  logoId                        String?          @map("logo_id") @db.Uuid
  coverId                       String?          @map("cover_id") @db.Uuid
  /// #rrggbb
  brandColor                    String?          @map("brand_color") @db.Char(7)
  /// Look of the public menu (contracts: MENU_THEMES).
  menuTheme                     String           @default("classic") @map("menu_theme") @db.VarChar(30)
  /// Extra languages the menu is offered in besides Arabic and English (contracts: EXTRA_MENU_LANGUAGES), in order.
  menuLanguages                 String[]         @default([]) @map("menu_languages")
  /// Bumped on every change to the public menu (including branch overrides); part of its cache key.
  menuVersion                   Int              @default(0) @map("menu_version")
  /// Kitchen display: when an order turns ready on its own (every dish ready), or only by hand.
  kitchenReadyRule              KitchenReadyRule @default(ALL_ITEMS) @map("kitchen_ready_rule")
  /// Where the restaurant's menu lives (docs/SERVICES.md): Bilhanah's, its own QR menu elsewhere, or none.
  menuSource                    MenuSource       @default(BILHANAH) @map("menu_source")
  /// The restaurant's own QR menu, when it keeps one.
  externalMenuUrl               String?          @map("external_menu_url") @db.VarChar(500)
  /// The POS / cashier system it already uses, if any (for future integrations).
  externalPosName               String?          @map("external_pos_name") @db.VarChar(60)
  /// When the owner finished or skipped choosing services; null while not yet.
  setupCompletedAt              DateTime?        @map("setup_completed_at") @db.Timestamptz(3)
  createdAt                     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner                 User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  staff                 User[]                 @relation("RestaurantStaff")
  entitlements          Entitlement[]
  services              RestaurantService[]
  logo                  Media?                 @relation("RestaurantLogo", fields: [logoId], references: [id], onDelete: SetNull)
  cover                 Media?                 @relation("RestaurantCover", fields: [coverId], references: [id], onDelete: SetNull)
  media                 Media[]                @relation("RestaurantMedia")
  categories            Category[]
  menuItems             MenuItem[]
  payments              SubscriptionPayment[]
  reminders             ExpiryReminder[]
  tables                Table[]
  tableAreas            TableArea[]
  tableGroups           TableGroup[]
  reservations          Reservation[]
  tableSessions         TableSession[]
  serviceRequests       ServiceRequest[]
  recommendationRules   RecommendationRule[]
  recommendationEvents  RecommendationEvent[]
  orders                Order[]
  dailyStats            RestaurantDailyStat[]
  branches              Branch[]
  kitchenStations       KitchenStation[]
  employees             Employee[]
  attendancePolicies    AttendancePolicy[]
  shifts                Shift[]
  attendanceRecords     AttendanceRecord[]
  attendanceKiosks      AttendanceKiosk[]
  attendanceCorrections AttendanceCorrection[]
  cashSettings          CashSettings?
  cashRegisters         CashRegister[]
  cashShifts            CashShift[]
  cashTransactions      CashTransaction[]
  inventorySettings     InventorySettings?
  ingredients           Ingredient[]
  suppliers             Supplier[]
  inventoryStock        InventoryStock[]
  stockMovements        StockMovement[]
  purchases             Purchase[]
  wasteEntries          WasteEntry[]
  stockCounts           StockCount[]
  stockTransfers        StockTransfer[]
  reviewSettings        ReviewSettings?
  reviews               Review[]
  loyaltySettings       LoyaltySettings?
  loyaltyRewards        LoyaltyReward[]
  loyaltyTiers          LoyaltyTier[]
  loyaltyMembers        LoyaltyMember[]
  loyaltyTransactions   LoyaltyTransaction[]
  posAccount            PosAccount?
  posDevices            PosDevice[]
  posIntegrations       PosIntegration[]
  faqInteractions       FaqInteraction[]       @relation("RestaurantFaqInteractions")
  assistantSessions     AssistantSession[]     @relation("RestaurantAssistantSessions")
  supportTickets        SupportTicket[]        @relation("RestaurantSupportTickets")

  @@map("restaurants")
}

/// A location of a restaurant. Every restaurant has exactly one main branch
/// (partial unique index in SQL). The menu is shared; each branch may hide
/// dishes, mark them sold out and set its own prices (BranchMenuItem,
/// BranchVariantPrice). Tables, orders and staff belong to one branch.
model Branch {
  id              String   @id @default(uuid()) @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  name            String   @db.VarChar(80)
  /// Public address of the branch: {subdomain}.bilhanah.com/?b={slug}. Unique per restaurant.
  slug            String   @db.VarChar(40)
  /// Diners land here when they do not choose a branch; it cannot be archived or deleted.
  isMain          Boolean  @default(false) @map("is_main")
  /// Archived branches keep their history but are hidden from diners and take no orders.
  isActive        Boolean  @default(true) @map("is_active")
  phone           String   @db.VarChar(20)
  whatsappNumber  String?  @map("whatsapp_number") @db.VarChar(20)
  city            String   @db.VarChar(60)
  address         String   @db.VarChar(200)
  /// A Google Maps (or any map) link for directions.
  mapUrl          String?  @map("map_url") @db.VarChar(2048)
  /// The branch's "write a review" link on Google, offered to happy diners (docs/REVIEWS.md).
  googleReviewUrl String?  @map("google_review_url") @db.VarChar(2048)
  /// Weekly opening hours (contracts openingHoursSchema); null when not set.
  openingHours    Json?    @map("opening_hours")
  /// The branch has switched ordering on (it also needs a plan with ordering).
  orderingEnabled Boolean  @default(false) @map("ordering_enabled")
  acceptsDineIn   Boolean  @default(true) @map("accepts_dine_in")
  acceptsPickup   Boolean  @default(true) @map("accepts_pickup")
  /// Temporarily not taking new orders (busy kitchen, closing early).
  ordersPaused    Boolean  @default(false) @map("orders_paused")
  sortOrder       Int      @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant           Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staff                User[]                   @relation("BranchStaff")
  tables               Table[]
  tableAreas           TableArea[]
  tableGroups          TableGroup[]
  reservations         Reservation[]
  tableSessions        TableSession[]
  serviceRequests      ServiceRequest[]
  recommendationEvents RecommendationEvent[]
  orders               Order[]
  orderCounters        OrderCounter[]
  itemOverrides        BranchMenuItem[]
  priceOverrides       BranchVariantPrice[]
  employees            Employee[]
  attendancePolicy     AttendancePolicy?
  shifts               Shift[]
  attendanceRecords    AttendanceRecord[]
  attendanceKiosks     AttendanceKiosk[]
  cashRegisters        CashRegister[]
  cashShifts           CashShift[]
  cashTransactions     CashTransaction[]
  inventoryStock       InventoryStock[]
  stockMovements       StockMovement[]
  purchases            Purchase[]
  wasteEntries         WasteEntry[]
  stockCounts          StockCount[]
  transfersOut         StockTransfer[]          @relation("TransferFrom")
  transfersIn          StockTransfer[]          @relation("TransferTo")
  inventorySettings    InventoryBranchSettings?
  reviews              Review[]

  posDevices PosDevice[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, sortOrder])
  @@map("branches")
}

/// A branch's own take on a shared dish. Missing row: the dish behaves as on the shared menu.
model BranchMenuItem {
  branchId           String   @map("branch_id") @db.Uuid
  itemId             String   @map("item_id") @db.Uuid
  /// null follows the shared menu; false marks the dish sold out at this branch only.
  isAvailable        Boolean? @map("is_available")
  /// The branch does not offer this dish at all.
  isHidden           Boolean  @default(false) @map("is_hidden")
  /// The sold-out mark (isAvailable false) was set by inventory (auto sold-out), which may clear it
  /// again on restock. Any manual availability change clears this flag, so inventory never undoes it.
  soldOutByInventory Boolean  @default(false) @map("sold_out_by_inventory")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item   MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([branchId, itemId])
  @@index([itemId])
  @@map("branch_menu_items")
}

/// A branch's own price for one size of a shared dish.
model BranchVariantPrice {
  branchId      String   @map("branch_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  pricePiastres Int      @map("price_piastres")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch  Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant MenuItemVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([branchId, variantId])
  @@index([variantId])
  @@map("branch_variant_prices")
}

enum MediaKind {
  LOGO
  COVER
  ITEM
  /// A transfer receipt. Stored under private/ and never served publicly.
  PAYMENT_PROOF
  /// A diner's review photo: under private/ until the review is published, then public.
  REVIEW

  @@map("media_kind")
}

/// An uploaded image. The original and its resized WebP variants live in object storage.
model Media {
  id            String    @id @default(uuid()) @db.Uuid
  restaurantId  String    @map("restaurant_id") @db.Uuid
  kind          MediaKind
  /// Storage key prefix; variants are stored at {storageKey}/{width}.webp
  storageKey    String    @map("storage_key")
  width         Int
  height        Int
  /// Widths of the generated WebP variants, smallest first.
  variantWidths Int[]     @map("variant_widths")
  bytes         Int
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant    Restaurant            @relation("RestaurantMedia", fields: [restaurantId], references: [id], onDelete: Cascade)
  logoFor       Restaurant[]          @relation("RestaurantLogo")
  coverFor      Restaurant[]          @relation("RestaurantCover")
  menuItems     MenuItem[]
  paymentProofs SubscriptionPayment[]
  reviewPhotos  ReviewPhoto[]

  @@index([restaurantId])
  @@map("media")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  nameAr       String   @map("name_ar") @db.VarChar(80)
  nameEn       String?  @map("name_en") @db.VarChar(80)
  /// Names in extra menu languages: { "fr": { "name": "…" } } (contracts: Translations).
  translations Json     @default("{}")
  sortOrder    Int      @map("sort_order")
  isVisible    Boolean  @default(true) @map("is_visible")
  /// The kitchen station that prepares its dishes (a dish may choose another); the default station when null.
  stationId    String?  @map("station_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  station    KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  items      MenuItem[]

  @@index([restaurantId, sortOrder])
  @@map("categories")
}

model MenuItem {
  id            String   @id @default(uuid()) @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  nameAr        String   @map("name_ar") @db.VarChar(100)
  nameEn        String?  @map("name_en") @db.VarChar(100)
  descriptionAr String?  @map("description_ar") @db.VarChar(500)
  descriptionEn String?  @map("description_en") @db.VarChar(500)
  /// Name and description in extra menu languages: { "fr": { "name": "…", "description": "…" } }.
  translations  Json     @default("{}")
  imageId       String?  @map("image_id") @db.Uuid
  /// False while sold out; the item stays listed.
  isAvailable   Boolean  @default(true) @map("is_available")
  isVisible     Boolean  @default(true) @map("is_visible")
  sortOrder     Int      @map("sort_order")
  /// Its own kitchen station; follows its category's when null.
  stationId     String?  @map("station_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  station             KitchenStation?          @relation(fields: [stationId], references: [id], onDelete: SetNull)
  restaurant          Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category            Category                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  image               Media?                   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  variants            MenuItemVariant[]
  orderItems          OrderItem[]
  branchOverrides     BranchMenuItem[]
  recommendationRules RecommendationRule[]
  recommendedIn       RecommendationRuleItem[]
  reviewRatings       ReviewDishRating[]
  loyaltyRewards      LoyaltyReward[]

  @@index([categoryId, sortOrder])
  @@index([restaurantId])
  @@map("menu_items")
}

/// A size and its price. Single-price items have one variant without a name.
model MenuItemVariant {
  id            String       @id @default(uuid()) @db.Uuid
  itemId        String       @map("item_id") @db.Uuid
  nameAr        String?      @map("name_ar") @db.VarChar(40)
  nameEn        String?      @map("name_en") @db.VarChar(40)
  /// Size names in extra menu languages: { "fr": { "name": "…" } }.
  translations  Json         @default("{}")
  pricePiastres Int          @map("price_piastres")
  /// Energy in kcal; null when the restaurant does not show it.
  calories      Int?
  /// The portion: an amount and its unit (both or neither, CHECK in SQL).
  portionValue  Int?         @map("portion_value")
  portionUnit   PortionUnit? @map("portion_unit")
  /// How many people this size serves.
  serves        Int?         @db.SmallInt
  sortOrder     Int          @map("sort_order")

  item          MenuItem                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branchPrices  BranchVariantPrice[]
  recommendedIn RecommendationRuleItem[]
  /// Its recipe (inventory): ingredient lines.
  recipeLines   RecipeLine[]
  orderItems    OrderItem[]
  wasteLines    WasteLine[]
  loyaltyRewards LoyaltyReward[]

  @@index([itemId, sortOrder])
  @@map("menu_item_variants")
}

/// Reference data inserted by migration. Prices are in piastres.
model Plan {
  code                 PlanCode @id
  priceMonthlyPiastres Int      @map("price_monthly_piastres")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  entitlements  Entitlement[]
  trialSettings TrialSettings[]
  payments      SubscriptionPayment[]

  @@map("plans")
}

/// A period of access. A partial unique index (see the init migration) allows one TRIAL per restaurant.
model Entitlement {
  id           String          @id @default(uuid()) @db.Uuid
  restaurantId String          @map("restaurant_id") @db.Uuid
  kind         EntitlementKind
  planCode     PlanCode        @map("plan_code")
  startsAt     DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime        @map("ends_at") @db.Timestamptz(3)
  /// Administrator who granted it by hand (null for trials and approved payments).
  grantedById  String?         @map("granted_by_id") @db.Uuid
  note         String?         @db.VarChar(300)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       Plan                 @relation(fields: [planCode], references: [code])
  grantedBy  User?                @relation(fields: [grantedById], references: [id], onDelete: SetNull)
  payment    SubscriptionPayment?
  reminders  ExpiryReminder[]

  @@index([restaurantId])
  @@map("entitlements")
}

/// Global defaults for new trials; a single row with id 1.
model TrialSettings {
  id           Int      @id @default(1)
  enabled      Boolean  @default(true)
  durationDays Int      @default(30) @map("duration_days")
  planCode     PlanCode @default(ADVANCED) @map("plan_code")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan Plan @relation(fields: [planCode], references: [code])

  @@map("trial_settings")
}

enum PaymentMethod {
  INSTAPAY
  VODAFONE_CASH
  BANK_TRANSFER
  /// Card or wallet through Paymob's checkout; confirmed by Paymob's callback.
  PAYMOB

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  /// An online payment started at Paymob and not finished yet.
  AWAITING_PAYMENT
  APPROVED
  REJECTED
  /// Withdrawn by the owner before review.
  CANCELLED
  /// Declined by Paymob.
  FAILED

  @@map("payment_status")
}

/// A subscription paid by manual transfer and reviewed by an administrator.
/// At most one PENDING payment per restaurant (partial unique index in SQL).
model SubscriptionPayment {
  id                  String        @id @default(uuid()) @db.Uuid
  restaurantId        String        @map("restaurant_id") @db.Uuid
  planCode            PlanCode      @map("plan_code")
  months              Int
  /// Computed by the server from the plan price at submission.
  amountPiastres      Int           @map("amount_piastres")
  method              PaymentMethod
  /// Transfer reference from the payer's receipt or SMS.
  reference           String        @db.VarChar(100)
  payerName           String?       @map("payer_name") @db.VarChar(80)
  proofId             String?       @map("proof_id") @db.Uuid
  status              PaymentStatus @default(PENDING)
  /// The paid period created on approval.
  entitlementId       String?       @unique @map("entitlement_id") @db.Uuid
  reviewedById        String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason     String?       @map("rejection_reason") @db.VarChar(300)
  /// Online payments: Paymob's order and the transaction that paid it.
  paymobOrderId       String?       @map("paymob_order_id") @db.VarChar(40)
  paymobTransactionId String?       @unique @map("paymob_transaction_id") @db.VarChar(40)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan        Plan         @relation(fields: [planCode], references: [code])
  proof       Media?       @relation(fields: [proofId], references: [id], onDelete: SetNull)
  entitlement Entitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  reviewedBy  User?        @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([restaurantId, createdAt])
  @@map("subscription_payments")
}

/// Where owners send money; edited by administrators. A single row with id 1.
model PaymentSettings {
  id                 Int      @id @default(1)
  instapayAddress    String?  @map("instapay_address") @db.VarChar(100)
  vodafoneCashNumber String?  @map("vodafone_cash_number") @db.VarChar(20)
  bankName           String?  @map("bank_name") @db.VarChar(80)
  bankAccountName    String?  @map("bank_account_name") @db.VarChar(100)
  bankAccountNumber  String?  @map("bank_account_number") @db.VarChar(40)
  notesAr            String?  @map("notes_ar") @db.VarChar(500)
  notesEn            String?  @map("notes_en") @db.VarChar(500)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("payment_settings")
}

/// Administrator actions, kept for accountability.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  /// Set for a restaurant's own events (its staff changes), so its owner can read them.
  restaurantId String?  @map("restaurant_id") @db.Uuid
  action       String   @db.VarChar(60)
  targetType   String   @map("target_type") @db.VarChar(40)
  targetId     String?  @map("target_id") @db.VarChar(64)
  metadata     Json?
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([restaurantId, createdAt])
  @@map("audit_logs")
}

/// Sent expiry reminders, so each goes out once per period.
model ExpiryReminder {
  id            String   @id @default(uuid()) @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  entitlementId String   @map("entitlement_id") @db.Uuid
  /// Days before the period ends; 0 means it has ended.
  daysBefore    Int      @map("days_before")
  sentAt        DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)

  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  entitlement Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@unique([entitlementId, daysBefore])
  @@map("expiry_reminders")
}

/// A dining table of one branch, with its own QR code ({publicUrl}/?t={publicCode}).
model Table {
  id               String           @id @default(uuid()) @db.Uuid
  restaurantId     String           @map("restaurant_id") @db.Uuid
  branchId         String           @map("branch_id") @db.Uuid
  label            String           @db.VarChar(40)
  /// How the table is drawn on the floor plan, and how many guests it seats.
  shape            TableShape       @default(SQUARE)
  seats            Int              @default(4) @db.SmallInt
  /// Where the table stands: inside the restaurant or outside (a terrace, the street). Follows its area's when it has one.
  location         TableLocation    @default(INDOOR)
  /// The seating area it belongs to (Main hall, Garden, ...); none when the owner has not sorted it.
  areaId           String?          @map("area_id") @db.Uuid
  /// Where it sits on the floor plan, in percent of the plan's width and height; null until placed.
  floorX           Float?           @map("floor_x") @db.Real
  floorY           Float?           @map("floor_y") @db.Real
  /// How the table is turned on the plan (degrees, clockwise) and how big it is drawn (1 = its natural size).
  floorRotation    Int              @default(0) @map("floor_rotation") @db.SmallInt
  floorScale       Float            @default(1) @map("floor_scale") @db.Real
  /// The least a party at this table orders (VIP tables, for example); null for none.
  minOrderPiastres Int?             @map("min_order_piastres")
  notes            String?          @db.VarChar(200)
  attributes       TableAttribute[] @default([])
  /// Random code printed in the table's QR; regenerating it retires printed codes.
  publicCode       String           @unique @map("public_code") @db.VarChar(16)
  /// Switched off: the table shows as unavailable and takes no orders or bookings.
  isActive         Boolean          @default(true) @map("is_active")
  /// Its housekeeping state: CLEANING after the guests leave (set when the bill is settled) until staff mark it ready.
  condition        TableCondition   @default(READY)
  conditionAt      DateTime?        @map("condition_at") @db.Timestamptz(3)
  /// The merged seating group it belongs to now, if any (see TableGroup).
  groupId          String?          @map("group_id") @db.Uuid
  sortOrder        Int              @map("sort_order")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  area            TableArea?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  group           TableGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  dailyStats      TableDailyStat[]
  orders          Order[]
  reservations    Reservation[]
  sessions        TableSession[]
  serviceRequests ServiceRequest[]

  @@unique([branchId, label])
  @@index([restaurantId])
  @@index([branchId, sortOrder])
  @@index([areaId])
  @@index([groupId])
  @@map("tables")
}

/// Tables merged for a larger party: one seating group with the seats of all of them and one shared session (on
/// the lead table). Separating them ends the group (dissolvedAt) but keeps its record; orders stay on their tables.
model TableGroup {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  /// The table whose session the whole group shares.
  leadTableId  String    @map("lead_table_id") @db.Uuid
  /// The tables merged, as they were (kept after the group is dissolved).
  tableIds     String[]  @map("table_ids") @db.Uuid
  label        String?   @db.VarChar(40)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  dissolvedAt  DateTime? @map("dissolved_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables     Table[]

  @@index([branchId, dissolvedAt])
  @@map("table_groups")
}

/// A seating area of one branch (Main hall, Garden, Rooftop, VIP): a name, indoor or outdoor, and its tables.
model TableArea {
  id           String         @id @default(uuid()) @db.Uuid
  restaurantId String         @map("restaurant_id") @db.Uuid
  branchId     String         @map("branch_id") @db.Uuid
  name         String         @db.VarChar(40)
  location     TableLocation  @default(INDOOR)
  /// How the area is drawn on the floor plan (stone hall, garden lawn, rooftop, wooden terrace, ...).
  theme        TableAreaTheme @default(HALL)
  sortOrder    Int            @map("sort_order")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables     Table[]

  @@unique([branchId, name])
  @@index([restaurantId])
  @@index([branchId, sortOrder])
  @@map("table_areas")
}

/// How a menu size's portion is measured.
enum PortionUnit {
  GRAM
  ML
  PIECE

  @@map("portion_unit")
}

enum TableShape {
  ROUND
  SQUARE
  RECTANGLE

  @@map("table_shape")
}

enum TableLocation {
  INDOOR
  OUTDOOR

  @@map("table_location")
}

enum TableAreaTheme {
  HALL
  GARDEN
  ROOFTOP
  TERRACE
  VIP
  SMOKING

  @@map("table_area_theme")
}

enum TableAttribute {
  WINDOW
  SOFA
  VIP
  ACCESSIBLE
  POWER_OUTLET
  QUIET
  SMOKING

  @@map("table_attribute")
}

enum RecommendationType {
  FREQUENTLY_BOUGHT_TOGETHER
  ADD_ON
  UPGRADE
  ALTERNATIVE

  @@map("recommendation_type")
}

enum RecommendationPlacement {
  PRODUCT_DETAILS
  CART
  CHECKOUT

  @@map("recommendation_placement")
}

enum RecommendationEventKind {
  IMPRESSION
  CLICK
  ADD

  @@map("recommendation_event_kind")
}

/// What the restaurant suggests with a dish (bought together, add-ons, an upgrade, alternatives) and where diners see it.
model RecommendationRule {
  id           String                    @id @default(uuid()) @db.Uuid
  restaurantId String                    @map("restaurant_id") @db.Uuid
  sourceItemId String                    @map("source_item_id") @db.Uuid
  type         RecommendationType
  placements   RecommendationPlacement[]
  /// Shown above the suggestions instead of the type's default heading.
  title        String?                   @db.VarChar(60)
  /// Add-ons on the dish page only: the diner picks at least one before adding the dish (while any is available).
  required     Boolean                   @default(false)
  isActive     Boolean                   @default(true) @map("is_active")
  sortOrder    Int                       @map("sort_order")
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sourceItem MenuItem                 @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  items      RecommendationRuleItem[]
  events     RecommendationEvent[]
  orderItems OrderItem[]

  @@index([restaurantId, sortOrder])
  @@index([sourceItemId])
  @@map("recommendation_rules")
}

/// One suggested dish of a rule: a size (or the diner's choice when null) and how many may be added.
model RecommendationRuleItem {
  id          String  @id @default(uuid()) @db.Uuid
  ruleId      String  @map("rule_id") @db.Uuid
  itemId      String  @map("item_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  maxQuantity Int     @default(1) @map("max_quantity") @db.SmallInt
  sortOrder   Int     @map("sort_order")

  rule    RecommendationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  item    MenuItem           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variant MenuItemVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([ruleId, sortOrder])
  @@index([itemId])
  @@map("recommendation_rule_items")
}

/// A diner saw, opened or added a suggestion (purchases are the order lines that carry a rule).
model RecommendationEvent {
  id           String                  @id @default(uuid()) @db.Uuid
  restaurantId String                  @map("restaurant_id") @db.Uuid
  branchId     String?                 @map("branch_id") @db.Uuid
  ruleId       String?                 @map("rule_id") @db.Uuid
  itemId       String                  @map("item_id") @db.Uuid
  kind         RecommendationEventKind
  placement    RecommendationPlacement
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  rule       RecommendationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([ruleId, kind])
  @@map("recommendation_events")
}

enum ServiceRequestType {
  CALL_WAITER
  REQUEST_BILL
  REQUEST_WATER
  REQUEST_NAPKINS
  REQUEST_CLEANING
  CUSTOM

  @@map("service_request_type")
}

enum ServiceRequestStatus {
  PENDING
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("service_request_status")
}

/// The guests at one table, from the first scan until the bill is settled (or it goes idle).
/// Everyone at the table shares it; their service requests belong to it.
model TableSession {
  id             String                   @id @default(uuid()) @db.Uuid
  restaurantId   String                   @map("restaurant_id") @db.Uuid
  branchId       String                   @map("branch_id") @db.Uuid
  tableId        String                   @map("table_id") @db.Uuid
  /// At most one session that is not CLOSED per table (partial unique index in SQL).
  status         TableSessionStatus       @default(ACTIVE)
  closedReason   TableSessionCloseReason? @map("closed_reason")
  startedAt      DateTime                 @default(now()) @map("started_at") @db.Timestamptz(3)
  lastActivityAt DateTime                 @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  /// Set with status CLOSED.
  endedAt        DateTime?                @map("ended_at") @db.Timestamptz(3)
  /// Bumped on every change to its guests, dishes or status.
  version        Int                      @default(0)

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table      Table            @relation(fields: [tableId], references: [id], onDelete: Cascade)
  requests   ServiceRequest[]
  guests     TableGuest[]
  cartItems  TableCartItem[]
  orders     Order[]

  @@index([tableId, endedAt])
  @@index([restaurantId])
  @@index([branchId, status])
  @@map("table_sessions")
}

/// A diner's request to the staff (call a waiter, bring the bill, water, ...), with who handles it and when.
model ServiceRequest {
  id               String               @id @default(uuid()) @db.Uuid
  restaurantId     String               @map("restaurant_id") @db.Uuid
  branchId         String               @map("branch_id") @db.Uuid
  /// Null once the table is deleted; the label stays.
  tableId          String?              @map("table_id") @db.Uuid
  tableLabel       String               @map("table_label") @db.VarChar(40)
  sessionId        String               @map("session_id") @db.Uuid
  type             ServiceRequestType
  status           ServiceRequestStatus @default(PENDING)
  note             String?              @db.VarChar(200)
  assignedToId     String?              @map("assigned_to_id") @db.Uuid
  assignedAt       DateTime?            @map("assigned_at") @db.Timestamptz(3)
  /// The last staff member who changed it.
  handledById      String?              @map("handled_by_id") @db.Uuid
  acknowledgedAt   DateTime?            @map("acknowledged_at") @db.Timestamptz(3)
  startedAt        DateTime?            @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?            @map("completed_at") @db.Timestamptz(3)
  cancelledAt      DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  /// The guests withdrew it themselves (rather than the staff cancelling it).
  cancelledByGuest Boolean              @default(false) @map("cancelled_by_guest")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table      Table?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  session    TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignedTo User?        @relation("ServiceRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  handledBy  User?        @relation("ServiceRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([branchId, status, createdAt])
  @@index([restaurantId, createdAt])
  @@index([tableId, type, createdAt])
  @@index([sessionId])
  @@map("service_requests")
}

/// A table's housekeeping state, kept apart from what orders and bookings say about it.
enum TableCondition {
  READY
  CLEANING

  @@map("table_condition")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("reservation_status")
}

/// A booking taken by staff: who, when, how many, and (optionally) which table.
model Reservation {
  id            String            @id @default(uuid()) @db.Uuid
  restaurantId  String            @map("restaurant_id") @db.Uuid
  branchId      String            @map("branch_id") @db.Uuid
  tableId       String?           @map("table_id") @db.Uuid
  customerName  String            @map("customer_name") @db.VarChar(80)
  customerPhone String?           @map("customer_phone") @db.VarChar(20)
  guests        Int               @db.SmallInt
  reservedAt    DateTime          @map("reserved_at") @db.Timestamptz(3)
  status        ReservationStatus @default(CONFIRMED)
  notes         String?           @db.VarChar(300)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table      Table?     @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([branchId, reservedAt])
  @@index([tableId, reservedAt])
  @@map("reservations")
}

enum OrderType {
  DINE_IN
  PICKUP

  @@map("order_type")
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  REJECTED
  CANCELLED

  @@map("order_status")
}

/// An order placed by a diner. Names and prices are copied at placement, so menu edits never change it.
model Order {
  id               String              @id @default(uuid()) @db.Uuid
  /// Placed through Bilhanah, or brought in from another system (a POS) by an integration.
  source           DataSource          @default(BILHANAH)
  restaurantId     String              @map("restaurant_id") @db.Uuid
  /// The branch that receives and prepares the order.
  branchId         String              @map("branch_id") @db.Uuid
  /// Daily sequence per branch (restaurant time zone): #1, #2, ...
  number           Int
  /// The restaurant's local date the number belongs to.
  businessDay      DateTime            @map("business_day") @db.Date
  type             OrderType
  tableId          String?             @map("table_id") @db.Uuid
  /// Kept even if the table is renamed or deleted.
  tableLabel       String?             @map("table_label") @db.VarChar(40)
  customerName     String              @map("customer_name") @db.VarChar(60)
  customerPhone    String?             @map("customer_phone") @db.VarChar(20)
  note             String?             @db.VarChar(300)
  status           OrderStatus         @default(PLACED)
  subtotalPiastres Int                 @map("subtotal_piastres")
  /// Client-generated key; a retried submission returns the same order.
  idempotencyKey   String              @map("idempotency_key") @db.VarChar(64)
  rejectionReason  String?             @map("rejection_reason") @db.VarChar(300)
  placedAt         DateTime            @default(now()) @map("placed_at") @db.Timestamptz(3)
  acceptedAt       DateTime?           @map("accepted_at") @db.Timestamptz(3)
  readyAt          DateTime?           @map("ready_at") @db.Timestamptz(3)
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz(3)
  closedAt         DateTime?           @map("closed_at") @db.Timestamptz(3)
  /// The restaurant marked the bill paid. A dine-in order not yet paid keeps its table occupied.
  paidAt           DateTime?           @map("paid_at") @db.Timestamptz(3)
  /// How the bill was paid; null while unpaid. Only CASH reaches a cashier's drawer.
  paymentMethod    OrderPaymentMethod? @map("payment_method")
  /// The shared table session it was sent from (or that was open at the table when placed).
  tableSessionId   String?             @map("table_session_id") @db.Uuid
  /// When the diner can expect it ready, set by the restaurant on accepting (or while preparing).
  estimatedReadyAt DateTime?           @map("estimated_ready_at") @db.Timestamptz(3)
  /// The first time the diner opened the tracking page (for tracking usage).
  trackedAt        DateTime?           @map("tracked_at") @db.Timestamptz(3)
  /// A "ready" notification reached at least one of the diner's browsers.
  readyNotifiedAt  DateTime?           @map("ready_notified_at") @db.Timestamptz(3)
  /// Rush orders go to the top of the kitchen display.
  priority         OrderPriority       @default(NORMAL)
  /// Inventory WARN policy: dishes whose recipe the branch's stock could not cover when it was placed.
  lowStockItemIds  String[]            @default([]) @map("low_stock_item_ids") @db.Uuid
  /// When its recipes were deducted from stock (inventory deductOn reached); null until then.
  stockDeductedAt  DateTime?           @map("stock_deducted_at") @db.Timestamptz(3)
  /// A paid bill marked unpaid again (a refund); cleared when it is paid again.
  refundedAt       DateTime?           @map("refunded_at") @db.Timestamptz(3)
  /// Taken off the subtotal (a loyalty reward, or a POS discount with its reason).
  discountPiastres Int                 @default(0) @map("discount_piastres")
  discountReason   String?             @map("discount_reason") @db.VarChar(200)
  /// POS orders: service charge and tax (tax included in the prices is shown, not added).
  serviceChargePiastres Int            @default(0) @map("service_charge_piastres")
  taxPiastres      Int                 @default(0) @map("tax_piastres")
  /// The bill: subtotal − discount + service charge (+ tax added on top). Set when the order is placed.
  totalPiastres    Int                 @default(0) @map("total_piastres")
  /// Where it was taken: the diner's menu or the POS (docs/POS.md), and the staff member who took it.
  channel          OrderChannel        @default(MENU)
  createdById      String?             @map("created_by_id") @db.Uuid
  createdByName    String?             @map("created_by_name") @db.VarChar(100)
  /// The registered POS device it was taken on.
  posDeviceId      String?             @map("pos_device_id") @db.Uuid
  /// Loyalty (docs/LOYALTY.md): the member the order counts for, and the reward applied (names are copies).
  loyaltyMemberId     String?          @map("loyalty_member_id") @db.Uuid
  loyaltyRewardId     String?          @map("loyalty_reward_id") @db.Uuid
  loyaltyRewardName   String?          @map("loyalty_reward_name") @db.VarChar(80)
  /// Points the reward cost, and the points the order earns once it reaches the program's completion state (fixed when placed).
  loyaltyPointsSpent  Int              @default(0) @map("loyalty_points_spent")
  loyaltyPointsToEarn Int              @default(0) @map("loyalty_points_to_earn")
  /// Whether the points are currently credited / the spent points currently taken (switched with a compare-and-swap, so never twice).
  loyaltyEarned       Boolean          @default(false) @map("loyalty_earned")
  loyaltySpentHeld    Boolean          @default(false) @map("loyalty_spent_held")
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant        Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch            Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table             Table?               @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  pushSubscriptions PushSubscription[]
  statusEvents      OrderStatusEvent[]
  tableTransfers    OrderTableTransfer[]
  itemEvents        OrderItemEvent[]
  cashTransactions  CashTransaction[]
  tableSession      TableSession?        @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  tableCartItems    TableCartItem[]
  stockMovements    StockMovement[]
  review            Review?
  loyaltyMember       LoyaltyMember?       @relation(fields: [loyaltyMemberId], references: [id], onDelete: SetNull)
  loyaltyReward       LoyaltyReward?       @relation(fields: [loyaltyRewardId], references: [id], onDelete: SetNull)
  loyaltyTransactions LoyaltyTransaction[]
  payments            OrderPayment[]
  posDevice           PosDevice?           @relation(fields: [posDeviceId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, idempotencyKey])
  @@unique([branchId, businessDay, number])
  @@index([restaurantId, businessDay, branchId])
  @@index([restaurantId, status, placedAt])
  @@index([restaurantId, placedAt])
  @@index([branchId, status, placedAt])
  @@index([branchId, tableId, paidAt])
  @@index([tableSessionId])
  @@index([loyaltyMemberId, placedAt])
  @@index([restaurantId, channel, placedAt])
  @@map("orders")
}

model OrderItem {
  id                      String                   @id @default(uuid()) @db.Uuid
  orderId                 String                   @map("order_id") @db.Uuid
  /// The menu item, while it still exists; the names and price below are copies.
  menuItemId              String?                  @map("menu_item_id") @db.Uuid
  nameAr                  String                   @map("name_ar") @db.VarChar(100)
  nameEn                  String?                  @map("name_en") @db.VarChar(100)
  variantNameAr           String?                  @map("variant_name_ar") @db.VarChar(40)
  variantNameEn           String?                  @map("variant_name_en") @db.VarChar(40)
  unitPricePiastres       Int                      @map("unit_price_piastres")
  quantity                Int
  note                    String?                  @db.VarChar(200)
  sortOrder               Int                      @map("sort_order")
  /// Added from a recommendation (checked when the order was placed), for its revenue and conversion.
  recommendationRuleId    String?                  @map("recommendation_rule_id") @db.Uuid
  recommendationPlacement RecommendationPlacement? @map("recommendation_placement")
  /// The kitchen station it was routed to when placed (null: the default station); the name is a copy.
  stationId               String?                  @map("station_id") @db.Uuid
  stationName             String?                  @map("station_name") @db.VarChar(40)
  /// Preparation on the kitchen display, with when it reached each step.
  prepStatus              OrderItemStatus          @default(NEW) @map("prep_status")
  acceptedAt              DateTime?                @map("accepted_at") @db.Timestamptz(3)
  startedAt               DateTime?                @map("started_at") @db.Timestamptz(3)
  readyAt                 DateTime?                @map("ready_at") @db.Timestamptz(3)
  servedAt                DateTime?                @map("served_at") @db.Timestamptz(3)
  cancelledAt             DateTime?                @map("cancelled_at") @db.Timestamptz(3)
  /// Who added it in a shared table session; the name is a copy.
  guestId                 String?                  @map("guest_id") @db.Uuid
  guestName               String?                  @map("guest_name") @db.VarChar(30)
  /// The size ordered, while it still exists (its recipe is what the line deducts).
  variantId               String?                  @map("variant_id") @db.Uuid
  /// What the line's ingredients cost (whole line, all its quantity), set when the order is accepted
  /// and its stock deducted; null without a recipe or inventory.
  costPiastres            Int?                     @map("cost_piastres")

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  guest              TableGuest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  menuItem           MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  variant            MenuItemVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  stockMovements     StockMovement[]
  recommendationRule RecommendationRule? @relation(fields: [recommendationRuleId], references: [id], onDelete: SetNull)
  station            KitchenStation?     @relation(fields: [stationId], references: [id], onDelete: SetNull)
  events             OrderItemEvent[]
  reviewRatings      ReviewDishRating[]

  @@index([orderId])
  @@index([stationId])
  @@map("order_items")
}

enum OrderItemStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED

  @@map("order_item_status")
}

enum OrderPriority {
  NORMAL
  RUSH

  @@map("order_priority")
}

enum KitchenReadyRule {
  /// The order turns ready once every dish (not cancelled) is ready.
  ALL_ITEMS
  /// Only someone marking the whole order ready does.
  MANUAL

  @@map("kitchen_ready_rule")
}

enum KitchenStationKind {
  MAIN
  GRILL
  DRINKS
  DESSERTS
  COLD
  BAKERY
  OTHER

  @@map("kitchen_station_kind")
}

/// Where dishes are prepared (main kitchen, grill, drinks, desserts...). Each station's screen sees only its dishes.
model KitchenStation {
  id            String             @id @default(uuid()) @db.Uuid
  restaurantId  String             @map("restaurant_id") @db.Uuid
  nameAr        String             @map("name_ar") @db.VarChar(40)
  nameEn        String?            @map("name_en") @db.VarChar(40)
  kind          KitchenStationKind @default(OTHER)
  /// Minutes a dish here usually takes; past it, the order shows as late.
  targetMinutes Int                @default(15) @map("target_minutes") @db.SmallInt
  /// Dishes with no station (theirs or their category's) go here. Exactly one per restaurant.
  isDefault     Boolean            @default(false) @map("is_default")
  isActive      Boolean            @default(true) @map("is_active")
  sortOrder     Int                @map("sort_order")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories Category[]
  menuItems  MenuItem[]
  orderItems OrderItem[]

  @@index([restaurantId, sortOrder])
  @@map("kitchen_stations")
}

/// Each preparation step of an order line on the kitchen display: who moved it, where, and when.
model OrderItemEvent {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @map("order_id") @db.Uuid
  orderItemId String          @map("order_item_id") @db.Uuid
  status      OrderItemStatus
  actorId     String?         @map("actor_id") @db.Uuid
  actorName   String?         @map("actor_name") @db.VarChar(100)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  actor User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([orderItemId, createdAt])
  @@map("order_item_events")
}

/// The last order number used per branch and business day.
model OrderCounter {
  branchId    String   @map("branch_id") @db.Uuid
  businessDay DateTime @map("business_day") @db.Date
  lastNumber  Int      @map("last_number")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([branchId, businessDay])
  @@map("order_counters")
}

/// A diner's browser asking to hear about one order (Web Push). Deleted once
/// the order is finished, or when the push service says it is gone.
/// The status history of an order: who moved it where, and when.
/// An order moved from one table to another (the guests changed tables): where from, where to, when and by whom.
/// The labels are kept so the record still reads after a table is renamed or deleted.
model OrderTableTransfer {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  fromTableId    String?  @map("from_table_id") @db.Uuid
  fromTableLabel String   @map("from_table_label") @db.VarChar(40)
  toTableId      String?  @map("to_table_id") @db.Uuid
  toTableLabel   String   @map("to_table_label") @db.VarChar(40)
  actorId        String?  @map("actor_id") @db.Uuid
  /// Kept when the account is removed.
  actorName      String?  @map("actor_name") @db.VarChar(100)
  reason         String?  @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_table_transfers")
}

model OrderStatusEvent {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  /// The staff account that made the change; null when the diner placed the order (or the account is gone).
  actorId   String?     @map("actor_id") @db.Uuid
  /// Kept when the account is removed.
  actorName String?     @map("actor_name") @db.VarChar(100)
  reason    String?     @db.VarChar(300)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

enum OrderPushUpdates {
  /// Ready, rejected and cancelled.
  READY
  /// Also accepted and preparing.
  ALL

  @@map("order_push_updates")
}

model PushSubscription {
  id        String           @id @default(uuid()) @db.Uuid
  orderId   String           @map("order_id") @db.Uuid
  endpoint  String           @db.VarChar(2048)
  /// The browser's keys for encrypting messages (base64url).
  p256dh    String           @db.VarChar(100)
  auth      String           @db.VarChar(32)
  /// Notifications are written in the language the diner's page used.
  language  Language         @default(ar)
  /// What the diner asked to hear about: the order turning ready (or not coming), or every step.
  updates   OrderPushUpdates @default(READY)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, endpoint])
  @@index([createdAt])
  @@map("push_subscriptions")
}

// --- Stand shop ---------------------------------------------------------------

enum StandOrderStatus {
  /// Online order whose payment is not finished; cancelled after two days.
  AWAITING_PAYMENT
  NEW
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("stand_order_status")
}

enum StandPaymentMethod {
  CASH_ON_DELIVERY
  PAYMOB

  @@map("stand_payment_method")
}

enum StandPaymentStatus {
  UNPAID
  PAID

  @@map("stand_payment_status")
}

/// What the stand-shop checkout offers; edited by administrators. A single row with id 1.
model ShopSettings {
  id                  Int      @id @default(1)
  /// Flat delivery fee; null when it is confirmed by phone.
  deliveryFeePiastres Int?     @map("delivery_fee_piastres")
  cashOnDelivery      Boolean  @default(true) @map("cash_on_delivery")
  onlinePayment       Boolean  @default(true) @map("online_payment")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("shop_settings")
}

/// A logo uploaded at checkout. Unused ones are deleted after two days.
model StandLogo {
  id         String   @id @default(uuid()) @db.Uuid
  storageKey String   @map("storage_key") @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lines StandOrderLine[]

  @@index([createdAt])
  @@map("stand_logos")
}

/// An order from the stand shop; customers need no account.
model StandOrder {
  id                  String             @id @default(uuid()) @db.Uuid
  /// Shown as "S-<number>".
  number              Int                @unique @default(autoincrement())
  status              StandOrderStatus
  paymentMethod       StandPaymentMethod @map("payment_method")
  paymentStatus       StandPaymentStatus @default(UNPAID) @map("payment_status")
  paidAt              DateTime?          @map("paid_at") @db.Timestamptz(3)
  customerName        String             @map("customer_name") @db.VarChar(80)
  phone               String             @db.VarChar(20)
  email               String?            @db.VarChar(254)
  city                String             @db.VarChar(60)
  address             String             @db.VarChar(300)
  customerNotes       String?            @map("customer_notes") @db.VarChar(500)
  adminNote           String?            @map("admin_note") @db.VarChar(1000)
  language            Language           @default(ar)
  subtotalPiastres    Int                @map("subtotal_piastres")
  /// Null when the fee is confirmed by phone.
  deliveryFeePiastres Int?               @map("delivery_fee_piastres")
  totalPiastres       Int                @map("total_piastres")
  /// Client-generated; a retried checkout returns the same order.
  idempotencyKey      String             @unique @map("idempotency_key") @db.VarChar(64)
  paymobOrderId       String?            @map("paymob_order_id") @db.VarChar(40)
  paymobTransactionId String?            @unique @map("paymob_transaction_id") @db.VarChar(40)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines  StandOrderLine[]
  events StandOrderEvent[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("stand_orders")
}

model StandOrderLine {
  id                String  @id @default(uuid()) @db.Uuid
  orderId           String  @map("order_id") @db.Uuid
  sortOrder         Int     @map("sort_order")
  /// "stand" or "sticker".
  product           String  @default("stand") @db.VarChar(20)
  shape             String  @db.VarChar(20)
  nfc               Boolean
  design            String  @db.VarChar(20)
  customBackground  String? @map("custom_background") @db.VarChar(7)
  customInk         String? @map("custom_ink") @db.VarChar(7)
  purpose           String  @db.VarChar(20)
  brand             String  @db.VarChar(35)
  caption           String  @db.VarChar(60)
  url               String  @db.VarChar(2048)
  logoId            String? @map("logo_id") @db.Uuid
  numbered          Boolean
  startNumber       Int     @map("start_number")
  quantity          Int
  notes             String  @db.VarChar(300)
  unitPricePiastres Int     @map("unit_price_piastres")

  order StandOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  logo  StandLogo? @relation(fields: [logoId], references: [id], onDelete: SetNull)

  @@index([orderId, sortOrder])
  @@map("stand_order_lines")
}

/// The order's history: every status change, by whom (null: the customer, Paymob or the system).
model StandOrderEvent {
  id        String           @id @default(uuid()) @db.Uuid
  orderId   String           @map("order_id") @db.Uuid
  status    StandOrderStatus
  note      String?          @db.VarChar(300)
  actorId   String?          @map("actor_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  order StandOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("stand_order_events")
}

// --- Analytics ----------------------------------------------------------------

/// Menu visits per restaurant and day (restaurant time zone), copied from Redis counters by the worker.
/// QR scans of one table per local day: a phone opening the menu from the table's code counts once per half hour.
model TableDailyStat {
  tableId      String   @map("table_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  day          DateTime @db.Date
  scans        Int      @default(0)

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@id([tableId, day])
  @@index([restaurantId, day])
  @@map("table_daily_stats")
}

model RestaurantDailyStat {
  restaurantId String   @map("restaurant_id") @db.Uuid
  day          DateTime @db.Date
  visits       Int      @default(0)
  qrVisits     Int      @default(0) @map("qr_visits")
  tableVisits  Int      @default(0) @map("table_visits")
  linkVisits   Int      @default(0) @map("link_visits")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([restaurantId, day])
  @@index([day])
  @@map("restaurant_daily_stats")
}

// --- Staff attendance -------------------------------------------------------------------------------

enum AttendanceMethod {
  /// The employee signs in to their dashboard and taps check in.
  PORTAL
  /// The employee, signed in, scans the branch's QR code.
  QR
  /// A shared branch screen: employee number and PIN.
  KIOSK
  /// A registered USB fingerprint device (through its local service).
  FINGERPRINT
  /// Entered by a manager (on someone's behalf, or a correction).
  MANUAL

  @@map("attendance_method")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  INCOMPLETE
  EARLY_LEAVE
  OVERTIME
  PENDING_CORRECTION

  @@map("attendance_status")
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT

  @@map("attendance_event_type")
}

enum AttendanceQrMode {
  STATIC
  DYNAMIC

  @@map("attendance_qr_mode")
}

enum AttendanceLocationMode {
  OFF
  /// Outside the radius (or no location): recorded, but flagged for review.
  FLAG
  /// Outside the radius (or no location): refused.
  REJECT

  @@map("attendance_location_mode")
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("correction_status")
}

/// Someone whose attendance is tracked. May have no dashboard account (PIN or fingerprint only), or be linked to a staff account (then they can use the employee portal and QR).
model Employee {
  id             String    @id @default(uuid()) @db.Uuid
  restaurantId   String    @map("restaurant_id") @db.Uuid
  /// The branch they work at.
  branchId       String    @map("branch_id") @db.Uuid
  /// The number they type at the kiosk; unique in the restaurant.
  employeeNumber String    @map("employee_number") @db.VarChar(12)
  fullName       String    @map("full_name") @db.VarChar(100)
  jobTitle       String?   @map("job_title") @db.VarChar(60)
  phone          String?   @db.VarChar(20)
  /// Their staff account, if any (one employee per account).
  userId         String?   @unique @map("user_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  hireDate       DateTime? @map("hire_date") @db.Date
  /// Kiosk PIN (argon2id); never shown. A reset PIN must be changed by the employee.
  pinHash        String?   @map("pin_hash")
  pinMustChange  Boolean   @default(true) @map("pin_must_change")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant  Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch      Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user        User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  shifts      Shift[]
  records     AttendanceRecord[]
  events      AttendanceEvent[]
  corrections AttendanceCorrection[]

  @@unique([restaurantId, employeeNumber])
  @@index([branchId])
  @@map("employees")
}

/// How attendance works at a restaurant (branchId null) or one branch (overrides the restaurant's).
model AttendancePolicy {
  id                  String                 @id @default(uuid()) @db.Uuid
  restaurantId        String                 @map("restaurant_id") @db.Uuid
  branchId            String?                @unique @map("branch_id") @db.Uuid
  /// A branch row that follows the restaurant's rules (it then only holds the branch's QR code and secret).
  inherits            Boolean                @default(true)
  methods             AttendanceMethod[]     @default([PORTAL])
  primaryMethod       AttendanceMethod       @default(PORTAL) @map("primary_method")
  graceMinutes        Int                    @default(10) @map("grace_minutes") @db.SmallInt
  earlyCheckInMinutes Int                    @default(30) @map("early_check_in_minutes") @db.SmallInt
  lateCheckOutMinutes Int                    @default(60) @map("late_check_out_minutes") @db.SmallInt
  recordOvertime      Boolean                @default(true) @map("record_overtime")
  allowWithoutShift   Boolean                @default(false) @map("allow_without_shift")
  allowOutsideShift   Boolean                @default(false) @map("allow_outside_shift")
  allowMultipleShifts Boolean                @default(false) @map("allow_multiple_shifts")
  requireCheckOut     Boolean                @default(true) @map("require_check_out")
  correctionsEnabled  Boolean                @default(true) @map("corrections_enabled")
  /// Managers' manual edits wait for the owner's approval.
  manualNeedsApproval Boolean                @default(false) @map("manual_needs_approval")
  qrMode              AttendanceQrMode       @default(DYNAMIC) @map("qr_mode")
  qrTtlSeconds        Int                    @default(30) @map("qr_ttl_seconds") @db.SmallInt
  /// The branch's printed QR code (static mode); regenerating it retires printed copies.
  qrStaticCode        String?                @unique @map("qr_static_code") @db.VarChar(32)
  /// Signs the dynamic QR codes; rotating it invalidates them all.
  qrSecret            String?                @map("qr_secret") @db.VarChar(64)
  qrEnabled           Boolean                @default(true) @map("qr_enabled")
  locationMode        AttendanceLocationMode @default(OFF) @map("location_mode")
  latitude            Float?
  longitude           Float?
  radiusMeters        Int?                   @map("radius_meters")
  updatedById         String?                @map("updated_by_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("attendance_policies")
}

/// One employee's shift on one day (a leave day when isLeave).
model Shift {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  /// The restaurant's local date the shift starts on.
  day          DateTime @db.Date
  startsAt     DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime @map("ends_at") @db.Timestamptz(3)
  isLeave      Boolean  @default(false) @map("is_leave")
  name         String?  @db.VarChar(40)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  records    AttendanceRecord[]

  @@index([restaurantId, day])
  @@index([employeeId, day])
  @@map("shifts")
}

/// One attendance session: a check-in and (once there) its check-out, with its calculated status.
model AttendanceRecord {
  id                String            @id @default(uuid()) @db.Uuid
  restaurantId      String            @map("restaurant_id") @db.Uuid
  branchId          String            @map("branch_id") @db.Uuid
  employeeId        String            @map("employee_id") @db.Uuid
  shiftId           String?           @map("shift_id") @db.Uuid
  day               DateTime          @db.Date
  checkInAt         DateTime          @map("check_in_at") @db.Timestamptz(3)
  checkOutAt        DateTime?         @map("check_out_at") @db.Timestamptz(3)
  status            AttendanceStatus  @default(PRESENT)
  workedMinutes     Int               @default(0) @map("worked_minutes")
  lateMinutes       Int               @default(0) @map("late_minutes")
  earlyLeaveMinutes Int               @default(0) @map("early_leave_minutes")
  overtimeMinutes   Int               @default(0) @map("overtime_minutes")
  checkInMethod     AttendanceMethod  @map("check_in_method")
  checkOutMethod    AttendanceMethod? @map("check_out_method")
  kioskId           String?           @map("kiosk_id") @db.Uuid
  /// Location check failed (or was refused) under the FLAG policy.
  flagged           Boolean           @default(false)
  managerNote       String?           @map("manager_note") @db.VarChar(300)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant  Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch      Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift       Shift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  kiosk       AttendanceKiosk?       @relation(fields: [kioskId], references: [id], onDelete: SetNull)
  events      AttendanceEvent[]
  corrections AttendanceCorrection[]

  @@index([restaurantId, day])
  @@index([employeeId, day])
  @@map("attendance_records")
}

/// A single check-in or check-out, as it happened. Never edited; corrections add records' changes to the audit log.
model AttendanceEvent {
  id             String              @id @default(uuid()) @db.Uuid
  restaurantId   String              @map("restaurant_id") @db.Uuid
  employeeId     String              @map("employee_id") @db.Uuid
  recordId       String              @map("record_id") @db.Uuid
  type           AttendanceEventType
  at             DateTime            @db.Timestamptz(3)
  method         AttendanceMethod
  kioskId        String?             @map("kiosk_id") @db.Uuid
  /// The client's key for this event; a retried request records nothing new.
  idempotencyKey String?             @map("idempotency_key") @db.VarChar(64)
  /// Distance from the branch, flag reasons... never biometric data.
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  record   AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, idempotencyKey])
  @@index([recordId])
  @@map("attendance_events")
}

/// A shared branch screen for PIN attendance. Activated once with a code; then holds its own token.
model AttendanceKiosk {
  id                  String    @id @default(uuid()) @db.Uuid
  restaurantId        String    @map("restaurant_id") @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  name                String    @db.VarChar(60)
  /// One-time code typed on the kiosk screen to activate it (hashed); cleared once used.
  activationCodeHash  String?   @map("activation_code_hash") @db.VarChar(64)
  activationExpiresAt DateTime? @map("activation_expires_at") @db.Timestamptz(3)
  /// The kiosk's long-lived credential (SHA-256 of it).
  tokenHash           String?   @unique @map("token_hash") @db.VarChar(64)
  activatedAt         DateTime? @map("activated_at") @db.Timestamptz(3)
  lastSeenAt          DateTime? @map("last_seen_at") @db.Timestamptz(3)
  disabledAt          DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  records    AttendanceRecord[]

  @@index([restaurantId])
  @@map("attendance_kiosks")
}

/// An employee asking to fix a forgotten check-in or check-out; a manager approves or rejects it.
model AttendanceCorrection {
  id                String           @id @default(uuid()) @db.Uuid
  restaurantId      String           @map("restaurant_id") @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  recordId          String?          @map("record_id") @db.Uuid
  day               DateTime         @db.Date
  requestedCheckIn  DateTime?        @map("requested_check_in") @db.Timestamptz(3)
  requestedCheckOut DateTime?        @map("requested_check_out") @db.Timestamptz(3)
  reason            String           @db.VarChar(300)
  status            CorrectionStatus @default(PENDING)
  reviewedById      String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  reviewNote        String?          @map("review_note") @db.VarChar(300)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  record     AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  reviewedBy User?             @relation("AttendanceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([restaurantId, status])
  @@index([employeeId])
  @@map("attendance_corrections")
}

// --- Cashier shifts and cash reconciliation --------------------------------------------------------

enum OrderPaymentMethod {
  CASH
  CARD
  WALLET
  OTHER

  @@map("order_payment_method")
}

enum CashShiftStatus {
  OPEN
  /// The cashier is counting: no new cash movements; back to OPEN or on to CLOSED.
  CLOSING
  CLOSED

  @@map("cash_shift_status")
}

enum CashReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED

  @@map("cash_review_status")
}

enum CashTransactionKind {
  SALE
  REFUND
  CASH_IN
  CASH_OUT
  ADJUSTMENT
  CORRECTION

  @@map("cash_transaction_kind")
}

enum CashApprovalStatus {
  APPROVED
  PENDING
  REJECTED

  @@map("cash_approval_status")
}

enum ClosingNoteRule {
  NEVER
  ON_DISCREPANCY
  ALWAYS

  @@map("closing_note_rule")
}

/// A restaurant's reconciliation rules (defaults when missing: contracts DEFAULT_CASH_SETTINGS).
model CashSettings {
  restaurantId                 String          @id @map("restaurant_id") @db.Uuid
  allowSharedRegister          Boolean         @default(false) @map("allow_shared_register")
  requireShiftForCash          Boolean         @default(false) @map("require_shift_for_cash")
  adjustmentsNeedApproval      Boolean         @default(true) @map("adjustments_need_approval")
  discrepancyTolerancePiastres Int             @default(0) @map("discrepancy_tolerance_piastres")
  closingNote                  ClosingNoteRule @default(ON_DISCREPANCY) @map("closing_note")
  /// ISO 4217; every price in Bilhanah is in Egyptian piastres today.
  currency                     String          @default("EGP") @db.Char(3)
  updatedById                  String?         @map("updated_by_id") @db.Uuid
  updatedAt                    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("cash_settings")
}

/// A cash drawer at a branch. Archived registers keep their shifts.
model CashRegister {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  name         String   @db.VarChar(40)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shifts     CashShift[]

  @@unique([branchId, name])
  @@index([restaurantId])
  @@map("cash_registers")
}

/// One cashier's shift on a drawer, from the opening cash to the count at closing.
/// At most one active (OPEN or CLOSING) shift per cashier (partial unique index in SQL).
model CashShift {
  id                  String            @id @default(uuid()) @db.Uuid
  restaurantId        String            @map("restaurant_id") @db.Uuid
  branchId            String            @map("branch_id") @db.Uuid
  registerId          String?           @map("register_id") @db.Uuid
  /// Null once the account is deleted; cashierName keeps who it was.
  cashierId           String?           @map("cashier_id") @db.Uuid
  cashierName         String            @map("cashier_name") @db.VarChar(100)
  status              CashShiftStatus   @default(OPEN)
  currency            String            @default("EGP") @db.Char(3)
  openingPiastres     Int               @map("opening_piastres")
  openingNote         String?           @map("opening_note") @db.VarChar(500)
  openedAt            DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  closingStartedAt    DateTime?         @map("closing_started_at") @db.Timestamptz(3)
  closedAt            DateTime?         @map("closed_at") @db.Timestamptz(3)
  closedById          String?           @map("closed_by_id") @db.Uuid
  /// Frozen at closing (and recalculated by corrections).
  expectedPiastres    Int?              @map("expected_piastres")
  countedPiastres     Int?              @map("counted_piastres")
  /// counted − expected: negative is a shortage.
  discrepancyPiastres Int?              @map("discrepancy_piastres")
  closingNote         String?           @map("closing_note") @db.VarChar(500)
  reviewStatus        CashReviewStatus? @map("review_status")
  reviewedById        String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  reviewNote          String?           @map("review_note") @db.VarChar(500)
  /// Bumped on every change, for optimistic concurrency.
  version             Int               @default(0)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  register     CashRegister?     @relation(fields: [registerId], references: [id], onDelete: SetNull)
  cashier      User?             @relation("CashShiftCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  closedBy     User?             @relation("CashShiftCloser", fields: [closedById], references: [id], onDelete: SetNull)
  reviewedBy   User?             @relation("CashShiftReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  transactions CashTransaction[]

  @@index([restaurantId, openedAt])
  @@index([branchId, status])
  @@index([cashierId, openedAt])
  @@index([registerId, status])
  @@map("cash_shifts")
}

/// A movement of cash in a shift's drawer. Payments and refunds of a bill carry a source key
/// (unique), so a retried or concurrent request is never counted twice.
model CashTransaction {
  id             String              @id @default(uuid()) @db.Uuid
  restaurantId   String              @map("restaurant_id") @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  shiftId        String              @map("shift_id") @db.Uuid
  kind           CashTransactionKind
  /// Positive, except ADJUSTMENT and CORRECTION which are signed.
  amountPiastres Int                 @map("amount_piastres")
  reason         String?             @db.VarChar(300)
  orderId        String?             @map("order_id") @db.Uuid
  /// "order:{id}:sale:{paidAt ms}" and the like; null for manual movements.
  sourceKey      String?             @unique @map("source_key") @db.VarChar(120)
  approvalStatus CashApprovalStatus  @default(APPROVED) @map("approval_status")
  approvedById   String?             @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?           @map("approved_at") @db.Timestamptz(3)
  createdById    String?             @map("created_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift      CashShift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy  User?      @relation("CashTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?      @relation("CashTransactionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([shiftId, createdAt])
  @@index([restaurantId, approvalStatus])
  @@index([orderId])
  @@map("cash_transactions")
}

// --- Shared table sessions ---------------------------------------------------------------------------

enum TableSessionStatus {
  ACTIVE
  /// The table asked for the bill: no new dishes until the staff reopen it.
  CLOSING
  CLOSED

  @@map("table_session_status")
}

enum TableSessionCloseReason {
  SETTLED
  EXPIRED
  STAFF

  @@map("table_session_close_reason")
}

enum TableCartItemStatus {
  DRAFT
  SUBMITTED

  @@map("table_cart_item_status")
}

/// One phone at the table. Its signed token (contracts TABLE_GUEST_HEADER) carries this id.
model TableGuest {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  /// 1, 2, 3... in the order they joined ("Guest 2" until they give a name).
  number      Int      @db.SmallInt
  displayName String?  @map("display_name") @db.VarChar(30)
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  session    TableSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cartItems  TableCartItem[]
  orderItems OrderItem[]

  @@unique([sessionId, number])
  @@map("table_guests")
}

/// A dish in a table session's shared order. Names and price are copied when added and checked again
/// when sent; a sent dish (SUBMITTED) belongs to an order and no longer changes here.
model TableCartItem {
  id                String              @id @default(uuid()) @db.Uuid
  sessionId         String              @map("session_id") @db.Uuid
  guestId           String              @map("guest_id") @db.Uuid
  menuItemId        String              @map("menu_item_id") @db.Uuid
  variantId         String              @map("variant_id") @db.Uuid
  nameAr            String              @map("name_ar") @db.VarChar(100)
  nameEn            String?             @map("name_en") @db.VarChar(100)
  variantNameAr     String?             @map("variant_name_ar") @db.VarChar(40)
  variantNameEn     String?             @map("variant_name_en") @db.VarChar(40)
  unitPricePiastres Int                 @map("unit_price_piastres")
  quantity          Int                 @db.SmallInt
  note              String?             @db.VarChar(200)
  status            TableCartItemStatus @default(DRAFT)
  orderId           String?             @map("order_id") @db.Uuid
  /// Bumped on every change, so two phones cannot overwrite each other.
  version           Int                 @default(0)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  submittedAt       DateTime?           @map("submitted_at") @db.Timestamptz(3)

  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guest   TableGuest   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  order   Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([sessionId, status])
  @@index([orderId])
  @@map("table_cart_items")
}

// --- Inventory, recipes and costs (docs/INVENTORY.md) -----------------------------------------------

enum IngredientKind {
  /// Bought and stocked.
  RAW
  /// Made in-house from its recipe; holds no stock (using it uses its components).
  PREPARED

  @@map("ingredient_kind")
}

/// Base unit: grams (MASS), millilitres (VOLUME) or pieces (COUNT).
enum InventoryDimension {
  MASS
  VOLUME
  COUNT

  @@map("inventory_dimension")
}

enum StockMovementType {
  PURCHASE
  PURCHASE_VOID
  SALE
  SALE_REVERSAL
  WASTE
  COUNT_VARIANCE
  TRANSFER_IN
  TRANSFER_OUT

  @@map("stock_movement_type")
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  VOID

  @@map("purchase_status")
}

enum StockCountStatus {
  OPEN
  /// Posted by someone without inventory.approve while a variance is above the threshold: waits for approval.
  PENDING_APPROVAL
  POSTED
  CANCELLED

  @@map("stock_count_status")
}

/// When an order's stock is deducted: on reaching this status (or a later one).
enum InventoryDeductOn {
  ACCEPTED
  READY
  COMPLETED

  @@map("inventory_deduct_on")
}

/// What placing an order does when the branch's stock cannot cover its recipes.
enum InventoryStockPolicy {
  ALLOW_NEGATIVE
  /// Placed, flagged on the order (lowStockItemIds) and in the low-stock report.
  WARN
  /// Refused with 409 INSUFFICIENT_STOCK.
  BLOCK_ORDERS

  @@map("inventory_stock_policy")
}

/// The unit cost reports and costing value stock at.
enum InventoryValuationBasis {
  AVERAGE
  STANDARD

  @@map("inventory_valuation_basis")
}

/// The owner's inventory rules (defaults when missing: contracts DEFAULT_INVENTORY_SETTINGS).
model InventorySettings {
  restaurantId                  String                  @id @map("restaurant_id") @db.Uuid
  enabled                       Boolean                 @default(false)
  deductOn                      InventoryDeductOn       @default(ACCEPTED) @map("deduct_on")
  stockPolicy                   InventoryStockPolicy    @default(ALLOW_NEGATIVE) @map("stock_policy")
  autoSoldOut                   Boolean                 @default(true) @map("auto_sold_out")
  autoRestore                   Boolean                 @default(true) @map("auto_restore")
  valuationBasis                InventoryValuationBasis @default(AVERAGE) @map("valuation_basis")
  /// [{ code, nameAr, nameEn }]; null uses the defaults (contracts DEFAULT_WASTE_REASONS).
  wasteReasons                  Json?                   @map("waste_reasons")
  requireCountApproval          Boolean                 @default(false) @map("require_count_approval")
  countVarianceThresholdPercent Decimal                 @default(10) @map("count_variance_threshold_percent") @db.Decimal(7, 2)
  updatedById                   String?                 @map("updated_by_id") @db.Uuid
  updatedAt                     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  updatedBy  User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("inventory_settings")
}

/// A branch's own take on some inventory rules; null follows the restaurant's.
model InventoryBranchSettings {
  branchId     String                @id @map("branch_id") @db.Uuid
  restaurantId String                @map("restaurant_id") @db.Uuid
  stockPolicy  InventoryStockPolicy? @map("stock_policy")
  autoSoldOut  Boolean?              @map("auto_sold_out")
  autoRestore  Boolean?              @map("auto_restore")
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("inventory_branch_settings")
}

model Supplier {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String   @db.VarChar(80)
  phone        String?  @db.VarChar(30)
  email        String?  @db.VarChar(254)
  note         String?  @db.VarChar(300)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]
  purchases   Purchase[]

  @@unique([restaurantId, name])
  @@map("inventory_suppliers")
}

/// Something stocked or used. Quantities everywhere are in its base unit (see InventoryDimension).
model Ingredient {
  id                  String             @id @default(uuid()) @db.Uuid
  restaurantId        String             @map("restaurant_id") @db.Uuid
  nameAr              String             @map("name_ar") @db.VarChar(80)
  nameEn              String?            @map("name_en") @db.VarChar(80)
  /// Free text grouping for stock lists and valuation.
  category            String?            @db.VarChar(40)
  kind                IngredientKind     @default(RAW)
  dimension           InventoryDimension
  /// Piastres per base unit, used at a branch until it has an average cost.
  standardCost        Decimal?           @map("standard_cost") @db.Decimal(14, 4)
  /// Prepared ingredients: base units the recipe makes.
  yieldQuantity       Decimal?           @map("yield_quantity") @db.Decimal(14, 3)
  preferredSupplierId String?            @map("preferred_supplier_id") @db.Uuid
  /// Used as the reorder point at branches that have not set their own.
  defaultReorderPoint Decimal?           @map("default_reorder_point") @db.Decimal(14, 3)
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant        Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  preferredSupplier Supplier?           @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  units             IngredientUnit[]
  /// Its own recipe (prepared ingredients).
  recipe            RecipeLine[]        @relation("PreparedRecipe")
  /// Recipe lines (of dishes and prepared ingredients) that use it.
  usedIn            RecipeLine[]        @relation("RecipeComponent")
  stock             InventoryStock[]
  movements         StockMovement[]
  purchaseLines     PurchaseLine[]
  wasteLines        WasteLine[]
  countLines        StockCountLine[]
  transferLines     StockTransferLine[]

  @@unique([restaurantId, nameAr])
  @@index([restaurantId, kind])
  @@map("ingredients")
}

/// A purchase unit of an ingredient: factor base units each (kg = 1000 g).
model IngredientUnit {
  id           String  @id @default(uuid()) @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  nameAr       String  @map("name_ar") @db.VarChar(40)
  nameEn       String? @map("name_en") @db.VarChar(40)
  factor       Decimal @db.Decimal(14, 3)
  sortOrder    Int     @map("sort_order")

  ingredient    Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  purchaseLines PurchaseLine[]

  @@unique([ingredientId, nameAr])
  @@map("ingredient_units")
}

/// A line of a recipe: of a dish size (variantId) or of a prepared ingredient (preparedIngredientId),
/// exactly one of them (CHECK in SQL).
model RecipeLine {
  id                   String  @id @default(uuid()) @db.Uuid
  variantId            String? @map("variant_id") @db.Uuid
  preparedIngredientId String? @map("prepared_ingredient_id") @db.Uuid
  ingredientId         String  @map("ingredient_id") @db.Uuid
  /// Base units as served.
  quantity             Decimal @db.Decimal(14, 3)
  /// Trimming and loss, 0–90: usage = quantity / (1 − waste% / 100).
  wastePercent         Decimal @default(0) @map("waste_percent") @db.Decimal(5, 2)
  sortOrder            Int     @map("sort_order")

  variant            MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  preparedIngredient Ingredient?      @relation("PreparedRecipe", fields: [preparedIngredientId], references: [id], onDelete: Cascade)
  ingredient         Ingredient       @relation("RecipeComponent", fields: [ingredientId], references: [id], onDelete: NoAction)

  @@unique([variantId, ingredientId])
  @@unique([preparedIngredientId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_lines")
}

/// An ingredient at a branch: on hand (base units), weighted average cost and reorder levels.
model InventoryStock {
  branchId     String   @map("branch_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  /// May go negative: a sale is never blocked by stock.
  onHand       Decimal  @default(0) @map("on_hand") @db.Decimal(14, 3)
  /// Piastres per base unit; null until the branch has received it.
  avgCost      Decimal? @map("avg_cost") @db.Decimal(14, 4)
  reorderPoint Decimal? @map("reorder_point") @db.Decimal(14, 3)
  parLevel     Decimal? @map("par_level") @db.Decimal(14, 3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([branchId, ingredientId])
  @@index([restaurantId])
  @@index([ingredientId])
  @@map("inventory_stock")
}

/// The stock ledger: immutable, the only way stock changes. A unique source key per movement makes
/// every posting idempotent ("sale:{orderItemId}:{ingredientId}", "purchase:{lineId}"…).
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  branchId     String            @map("branch_id") @db.Uuid
  ingredientId String            @map("ingredient_id") @db.Uuid
  type         StockMovementType
  /// Signed base units (never zero): positive adds stock.
  quantity     Decimal           @db.Decimal(14, 3)
  /// Piastres per base unit the movement was valued at.
  unitCost     Decimal           @map("unit_cost") @db.Decimal(14, 4)
  /// quantity × unitCost: signed piastres.
  value        Decimal           @db.Decimal(16, 2)
  onHandAfter  Decimal           @map("on_hand_after") @db.Decimal(14, 3)
  avgCostAfter Decimal?          @map("avg_cost_after") @db.Decimal(14, 4)
  sourceKey    String            @unique @map("source_key") @db.VarChar(160)
  purchaseId   String?           @map("purchase_id") @db.Uuid
  orderId      String?           @map("order_id") @db.Uuid
  orderItemId  String?           @map("order_item_id") @db.Uuid
  wasteId      String?           @map("waste_id") @db.Uuid
  countId      String?           @map("count_id") @db.Uuid
  transferId   String?           @map("transfer_id") @db.Uuid
  note         String?           @db.VarChar(300)
  createdById  String?           @map("created_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: NoAction)
  purchase   Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  order      Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem  OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  waste      WasteEntry?    @relation(fields: [wasteId], references: [id], onDelete: SetNull)
  count      StockCount?    @relation(fields: [countId], references: [id], onDelete: SetNull)
  transfer   StockTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  createdBy  User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId, ingredientId, createdAt])
  @@index([restaurantId, type, createdAt])
  @@index([ingredientId])
  @@index([orderItemId])
  @@index([orderId])
  @@index([purchaseId])
  @@map("stock_movements")
}

/// Goods received from a supplier at a branch (an invoice): DRAFT → RECEIVED (posts stock) → VOID (reverses).
model Purchase {
  id            String         @id @default(uuid()) @db.Uuid
  restaurantId  String         @map("restaurant_id") @db.Uuid
  branchId      String         @map("branch_id") @db.Uuid
  supplierId    String?        @map("supplier_id") @db.Uuid
  /// A copy, kept if the supplier is renamed or deleted.
  supplierName  String?        @map("supplier_name") @db.VarChar(80)
  invoiceNumber String?        @map("invoice_number") @db.VarChar(60)
  invoiceDate   DateTime?      @map("invoice_date") @db.Date
  status        PurchaseStatus @default(DRAFT)
  note          String?        @db.VarChar(300)
  /// Piastres: the lines' totals.
  total         Decimal        @default(0) @db.Decimal(16, 2)
  createdById   String?        @map("created_by_id") @db.Uuid
  receivedAt    DateTime?      @map("received_at") @db.Timestamptz(3)
  receivedById  String?        @map("received_by_id") @db.Uuid
  voidedAt      DateTime?      @map("voided_at") @db.Timestamptz(3)
  voidedById    String?        @map("voided_by_id") @db.Uuid
  voidReason    String?        @map("void_reason") @db.VarChar(300)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier   Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy  User?           @relation("PurchaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  receivedBy User?           @relation("PurchaseReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  voidedBy   User?           @relation("PurchaseVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  lines      PurchaseLine[]
  movements  StockMovement[]

  @@index([restaurantId, createdAt])
  @@index([branchId, status, createdAt])
  @@index([supplierId])
  @@map("inventory_purchases")
}

/// quantity of a unit (factor base units each) at unitPrice piastres per unit.
model PurchaseLine {
  id           String  @id @default(uuid()) @db.Uuid
  purchaseId   String  @map("purchase_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  /// The unit chosen (null: the base unit); its names and factor are copies.
  unitId       String? @map("unit_id") @db.Uuid
  unitNameAr   String? @map("unit_name") @db.VarChar(40)
  unitNameEn   String? @map("unit_name_en") @db.VarChar(40)
  factor       Decimal @default(1) @db.Decimal(14, 3)
  quantity     Decimal @db.Decimal(14, 3)
  baseQuantity Decimal @map("base_quantity") @db.Decimal(14, 3)
  unitPrice    Decimal @map("unit_price") @db.Decimal(16, 4)
  lineTotal    Decimal @map("line_total") @db.Decimal(16, 2)
  sortOrder    Int     @map("sort_order")

  purchase   Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: NoAction)
  unit       IngredientUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([ingredientId])
  @@map("inventory_purchase_lines")
}

/// Stock thrown away or given away at a branch, with a reason; posted at once.
model WasteEntry {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  /// A code from the restaurant's waste reasons (settings); its names are copied, so editing the list keeps history.
  reason       String   @db.VarChar(40)
  reasonNameAr String   @map("reason_name_ar") @db.VarChar(60)
  reasonNameEn String?  @map("reason_name_en") @db.VarChar(60)
  note         String?  @db.VarChar(300)
  /// Piastres at the average cost.
  total        Decimal  @default(0) @db.Decimal(16, 2)
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy  User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines      WasteLine[]
  movements  StockMovement[]

  @@index([restaurantId, createdAt])
  @@index([branchId, createdAt])
  @@map("inventory_waste")
}

/// An ingredient (quantity in base units) or whole dishes of a size (their recipe is wasted).
model WasteLine {
  id           String  @id @default(uuid()) @db.Uuid
  wasteId      String  @map("waste_id") @db.Uuid
  ingredientId String? @map("ingredient_id") @db.Uuid
  variantId    String? @map("variant_id") @db.Uuid
  /// Copies, kept if the ingredient or dish changes.
  nameAr       String  @map("name_ar") @db.VarChar(150)
  nameEn       String? @map("name_en") @db.VarChar(150)
  /// The unit an ingredient line was entered in (null: the base unit), names copied.
  unitNameAr   String? @map("unit_name") @db.VarChar(40)
  unitNameEn   String? @map("unit_name_en") @db.VarChar(40)
  /// Base units (ingredient) or dishes (size).
  quantity     Decimal @db.Decimal(14, 3)
  value        Decimal @default(0) @db.Decimal(16, 2)
  sortOrder    Int     @map("sort_order")

  waste      WasteEntry       @relation(fields: [wasteId], references: [id], onDelete: Cascade)
  ingredient Ingredient?      @relation(fields: [ingredientId], references: [id], onDelete: NoAction)
  variant    MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([wasteId])
  @@index([ingredientId])
  @@map("inventory_waste_lines")
}

/// A stocktake at a branch. Expected quantities are snapshotted when it is created; posting books
/// counted − expected as COUNT_VARIANCE. One open (or pending) count per branch (partial unique index in SQL).
model StockCount {
  id            String           @id @default(uuid()) @db.Uuid
  restaurantId  String           @map("restaurant_id") @db.Uuid
  branchId      String           @map("branch_id") @db.Uuid
  status        StockCountStatus @default(OPEN)
  note          String?          @db.VarChar(300)
  createdById   String?          @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Sent for approval (PENDING_APPROVAL), and the approver's or rejecter's note.
  submittedAt   DateTime?        @map("submitted_at") @db.Timestamptz(3)
  submittedById String?          @map("submitted_by_id") @db.Uuid
  reviewNote    String?          @map("review_note") @db.VarChar(300)
  postedAt      DateTime?        @map("posted_at") @db.Timestamptz(3)
  postedById    String?          @map("posted_by_id") @db.Uuid
  cancelledAt   DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation("StockCountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy    User?            @relation("StockCountPoster", fields: [postedById], references: [id], onDelete: SetNull)
  submittedBy User?            @relation("StockCountSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  lines       StockCountLine[]
  movements   StockMovement[]

  @@index([restaurantId, createdAt])
  @@index([branchId, status])
  @@map("inventory_counts")
}

model StockCountLine {
  countId      String   @map("count_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  expected     Decimal  @db.Decimal(14, 3)
  counted      Decimal? @db.Decimal(14, 3)
  /// Piastres per base unit when posted.
  unitCost     Decimal? @map("unit_cost") @db.Decimal(14, 4)

  count      StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: NoAction)

  @@id([countId, ingredientId])
  @@index([ingredientId])
  @@map("inventory_count_lines")
}

/// Stock moved from one branch to another at the sender's average cost, posted in one step.
model StockTransfer {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  fromBranchId String   @map("from_branch_id") @db.Uuid
  toBranchId   String   @map("to_branch_id") @db.Uuid
  note         String?  @db.VarChar(300)
  total        Decimal  @default(0) @db.Decimal(16, 2)
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  fromBranch Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch   Branch              @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Cascade)
  createdBy  User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines      StockTransferLine[]
  movements  StockMovement[]

  @@index([restaurantId, createdAt])
  @@index([fromBranchId, createdAt])
  @@index([toBranchId, createdAt])
  @@map("inventory_transfers")
}

model StockTransferLine {
  id           String  @id @default(uuid()) @db.Uuid
  transferId   String  @map("transfer_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  quantity     Decimal @db.Decimal(14, 3)
  unitCost     Decimal @map("unit_cost") @db.Decimal(14, 4)
  value        Decimal @db.Decimal(16, 2)
  sortOrder    Int     @map("sort_order")

  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  ingredient Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: NoAction)

  @@index([transferId])
  @@index([ingredientId])
  @@map("inventory_transfer_lines")
}

// --- Feedback and reviews (docs/REVIEWS.md) ---------------------------------------------------------

enum ReviewAskAfter {
  READY
  COMPLETED

  @@map("review_ask_after")
}

enum ReviewDishScale {
  THUMBS
  STARS

  @@map("review_dish_scale")
}

enum ReviewPublishMode {
  AUTO
  MANUAL
  NEVER

  @@map("review_publish_mode")
}

enum ReviewDisplayName {
  FIRST_NAME_INITIAL
  FIRST_NAME
  ANONYMOUS

  @@map("review_display_name")
}

enum ReviewStatus {
  /// Waiting for moderation (or kept private while publishing is NEVER).
  PENDING
  PUBLISHED
  /// Hidden by a moderator, with a reason.
  HIDDEN

  @@map("review_status")
}

enum ReviewSource {
  /// Proven by the order's tracking link: verified.
  ORDER
  /// Unverified feedback from a table QR code.
  TABLE
  /// Unverified feedback from the menu.
  MENU

  @@map("review_source")
}

enum ReviewFollowUpStatus {
  OPEN
  CONTACTED
  RESOLVED

  @@map("review_follow_up_status")
}

enum ReviewEventKind {
  CREATED
  EDITED
  PUBLISHED
  HIDDEN
  REPLIED
  REPLY_REMOVED
  FOLLOW_UP

  @@map("review_event_kind")
}

/// What diners are asked, what is published, and alerts. A missing row means the defaults.
model ReviewSettings {
  restaurantId         String            @id @map("restaurant_id") @db.Uuid
  enabled              Boolean           @default(false)
  askAfter             ReviewAskAfter    @default(COMPLETED) @map("ask_after")
  allowUnverified      Boolean           @default(false) @map("allow_unverified")
  /// Extra 1–5 ratings asked (contracts REVIEW_SUB_RATINGS).
  subRatings           String[]          @default(["food", "service"]) @map("sub_ratings")
  dishRatings          Boolean           @default(true) @map("dish_ratings")
  dishRatingScale      ReviewDishScale   @default(THUMBS) @map("dish_rating_scale")
  /// A comment is required below this overall rating (0: never).
  commentRequiredBelow Int               @default(3) @map("comment_required_below") @db.SmallInt
  photos               Boolean           @default(true)
  /// [{ code, nameAr, nameEn, sentiment }]; null uses the defaults (contracts DEFAULT_REVIEW_TAGS).
  tags                 Json?
  publishMode          ReviewPublishMode @default(AUTO) @map("publish_mode")
  publishMinStars      Int               @default(1) @map("publish_min_stars") @db.SmallInt
  showOnMenu           Boolean           @default(false) @map("show_on_menu")
  menuMinCount         Int               @default(3) @map("menu_min_count")
  googlePrompt         Boolean           @default(true) @map("google_prompt")
  googleMinStars       Int               @default(4) @map("google_min_stars") @db.SmallInt
  /// Reviews below this alert the restaurant (0 or 1: never).
  alertBelowStars      Int               @default(3) @map("alert_below_stars") @db.SmallInt
  editWindowHours      Int               @default(24) @map("edit_window_hours")
  displayName          ReviewDisplayName @default(FIRST_NAME_INITIAL) @map("display_name")
  updatedById          String?           @map("updated_by_id") @db.Uuid
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  updatedBy  User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("review_settings")
}

/// A diner's review of a visit: verified (one per order, proven by its tracking link) or
/// unverified feedback from a table QR or the menu.
model Review {
  id                 String                @id @default(uuid()) @db.Uuid
  restaurantId       String                @map("restaurant_id") @db.Uuid
  branchId           String                @map("branch_id") @db.Uuid
  /// The reviewed order; one review per order. Null for unverified feedback.
  orderId            String?               @unique @map("order_id") @db.Uuid
  source             ReviewSource
  verified           Boolean
  /// Unverified feedback from a table: its label when sent (a copy).
  tableLabel         String?               @map("table_label") @db.VarChar(40)
  overall            Int                   @db.SmallInt
  foodRating         Int?                  @map("food_rating") @db.SmallInt
  serviceRating      Int?                  @map("service_rating") @db.SmallInt
  valueRating        Int?                  @map("value_rating") @db.SmallInt
  speedRating        Int?                  @map("speed_rating") @db.SmallInt
  cleanlinessRating  Int?                  @map("cleanliness_rating") @db.SmallInt
  atmosphereRating   Int?                  @map("atmosphere_rating") @db.SmallInt
  /// Tag codes (the restaurant's settings name them).
  tags               String[]              @default([])
  comment            String?               @db.VarChar(1000)
  authorName         String?               @map("author_name") @db.VarChar(40)
  /// Kept only with the diner's consent; never public.
  contactPhone       String?               @map("contact_phone") @db.VarChar(20)
  contactConsent     Boolean               @default(false) @map("contact_consent")
  language           Language              @default(ar)
  /// sha256 of the browser's edit key; edits must present the same key.
  editKeyHash        String?               @map("edit_key_hash") @db.Char(64)
  /// Fixed when the review is created (editWindowHours then).
  editableUntil      DateTime              @map("editable_until") @db.Timestamptz(3)
  editCount          Int                   @default(0) @map("edit_count")
  status             ReviewStatus          @default(PENDING)
  publishedAt        DateTime?             @map("published_at") @db.Timestamptz(3)
  hiddenAt           DateTime?             @map("hidden_at") @db.Timestamptz(3)
  hiddenReason       String?               @map("hidden_reason") @db.VarChar(300)
  /// The last moderator decision (publish or hide).
  moderatedById      String?               @map("moderated_by_id") @db.Uuid
  moderatedAt        DateTime?             @map("moderated_at") @db.Timestamptz(3)
  replyText          String?               @map("reply_text") @db.VarChar(1000)
  /// The first reply (for reply times); replyUpdatedAt the latest edit.
  repliedAt          DateTime?             @map("replied_at") @db.Timestamptz(3)
  replyUpdatedAt     DateTime?             @map("reply_updated_at") @db.Timestamptz(3)
  repliedById        String?               @map("replied_by_id") @db.Uuid
  followUpStatus     ReviewFollowUpStatus? @map("follow_up_status")
  followUpAssigneeId String?               @map("follow_up_assignee_id") @db.Uuid
  followUpUpdatedAt  DateTime?             @map("follow_up_updated_at") @db.Timestamptz(3)
  /// The low-rating alert went out (once per review).
  alertedAt          DateTime?             @map("alerted_at") @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant       Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch           Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order            Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  moderatedBy      User?              @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  repliedBy        User?              @relation("ReviewReplier", fields: [repliedById], references: [id], onDelete: SetNull)
  followUpAssignee User?              @relation("ReviewAssignee", fields: [followUpAssigneeId], references: [id], onDelete: SetNull)
  dishRatings      ReviewDishRating[]
  photos           ReviewPhoto[]
  events           ReviewEvent[]

  @@index([restaurantId, createdAt(sort: Desc)])
  @@index([branchId, createdAt(sort: Desc)])
  @@index([restaurantId, status, publishedAt(sort: Desc)])
  @@index([restaurantId, overall])
  @@index([followUpAssigneeId])
  @@map("reviews")
}

/// A diner's rating of one dish of their order (thumbs are stored as 5 / 1). Names are copies.
model ReviewDishRating {
  id          String   @id @default(uuid()) @db.Uuid
  reviewId    String   @map("review_id") @db.Uuid
  orderItemId String?  @map("order_item_id") @db.Uuid
  menuItemId  String?  @map("menu_item_id") @db.Uuid
  nameAr      String   @map("name_ar") @db.VarChar(100)
  nameEn      String?  @map("name_en") @db.VarChar(100)
  rating      Int      @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  review    Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  menuItem  MenuItem?  @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@unique([reviewId, orderItemId])
  @@index([menuItemId])
  @@map("review_dish_ratings")
}

/// A photo attached to a review (media kind REVIEW).
model ReviewPhoto {
  reviewId  String @map("review_id") @db.Uuid
  mediaId   String @unique @map("media_id") @db.Uuid
  sortOrder Int    @map("sort_order") @db.SmallInt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  media  Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([reviewId, mediaId])
  @@map("review_photos")
}

/// The review's history: the diner's edits (with the rating before), moderation, replies and follow-ups.
model ReviewEvent {
  id              String                @id @default(uuid()) @db.Uuid
  reviewId        String                @map("review_id") @db.Uuid
  kind            ReviewEventKind
  /// Null for the diner.
  actorId         String?               @map("actor_id") @db.Uuid
  actorName       String?               @map("actor_name") @db.VarChar(100)
  followUpStatus  ReviewFollowUpStatus? @map("follow_up_status")
  assigneeId      String?               @map("assignee_id") @db.Uuid
  assigneeName    String?               @map("assignee_name") @db.VarChar(100)
  /// The follow-up note (internal) or the reason a review was hidden.
  note            String?               @db.VarChar(500)
  previousOverall Int?                  @map("previous_overall") @db.SmallInt
  /// EDITED: the whole review before the edit.
  metadata        Json?
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  actor    User?  @relation("ReviewEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  assignee User?  @relation("ReviewEventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([reviewId, createdAt])
  @@map("review_events")
}

// --- Support ------------------------------------------------------------------
// A FAQ assistant in the restaurant dashboard, and tickets for Bilhanah's support team (admins).
// See bilhanah-backend/docs/SUPPORT.md.

enum SupportTopic {
  GETTING_STARTED
  RESTAURANT_SETUP
  MENU
  QR_TABLES
  ORDERS
  PAYMENTS
  BRANCHES
  BILLING
  ACCOUNT
  TROUBLESHOOTING

  @@map("support_topic")
}

enum FaqStatus {
  DRAFT
  PUBLISHED

  @@map("faq_status")
}

enum FaqInteractionKind {
  VIEW
  SEARCH
  FEEDBACK

  @@map("faq_interaction_kind")
}

/// A group of FAQs, named in both languages.
model FaqCategory {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  topic     SupportTopic
  nameAr    String       @map("name_ar")
  nameEn    String       @map("name_en")
  /// A Phosphor icon name the dashboard maps to an icon.
  icon      String       @default("question")
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  articles FaqArticle[]

  @@map("faq_categories")
}

/// One question and its fixed answer in one language. The same question in another language shares its key.
model FaqArticle {
  id          String    @id @default(uuid()) @db.Uuid
  key         String
  language    Language
  categoryId  String    @map("category_id") @db.Uuid
  question    String
  /// Markdown subset (paragraphs, bold, lists, links).
  answer      String
  keywords    String[]  @default([])
  /// Keys of related questions (in the same language).
  relatedKeys String[]  @default([]) @map("related_keys")
  /// Offered when the assistant opens.
  suggested   Boolean   @default(false)
  sortOrder   Int       @default(0) @map("sort_order")
  status      FaqStatus @default(DRAFT)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     FaqCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  revisions    FaqRevision[]
  interactions FaqInteraction[]
  tickets      SupportTicket[]

  @@unique([key, language])
  @@index([language, status, categoryId, sortOrder])
  @@map("faq_articles")
}

/// The article as it was at each version, and who changed it.
model FaqRevision {
  id        String    @id @default(uuid()) @db.Uuid
  articleId String    @map("article_id") @db.Uuid
  version   Int
  question  String
  answer    String
  keywords  String[]  @default([])
  status    FaqStatus
  editorId  String?   @map("editor_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  article FaqArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor  User?      @relation("FaqRevisionEditor", fields: [editorId], references: [id], onDelete: SetNull)

  @@unique([articleId, version])
  @@map("faq_revisions")
}

/// Views, searches and "was this helpful?" answers, per restaurant and user (one answer per user and article).
model FaqInteraction {
  id           String             @id @default(uuid()) @db.Uuid
  kind         FaqInteractionKind
  articleId    String?            @map("article_id") @db.Uuid
  restaurantId String?            @map("restaurant_id") @db.Uuid
  userId       String?            @map("user_id") @db.Uuid
  sessionId    String?            @map("session_id") @db.Uuid
  helpful      Boolean?
  query        String?
  resultCount  Int?               @map("result_count")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  article    FaqArticle? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation("RestaurantFaqInteractions", fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?       @relation("UserFaqInteractions", fields: [userId], references: [id], onDelete: SetNull)

  @@index([articleId, kind])
  @@index([restaurantId, createdAt])
  @@map("faq_interactions")
}

/// Where a conversation is with reaching a person: asking the customer what the problem is, or not.
enum AssistantHandoff {
  NONE
  COLLECTING

  @@map("assistant_handoff")
}

/// How a ticket was opened: the ticket form, or a live chat from the assistant.
enum SupportChannel {
  FORM
  CHAT

  @@map("support_channel")
}

enum AssistantMessageRole {
  USER
  ASSISTANT
  SYSTEM

  @@map("assistant_message_role")
}

/// A user's conversation with the assistant; the latest one is restored when the panel opens again.
model AssistantSession {
  id           String           @id @default(uuid()) @db.Uuid
  restaurantId String           @map("restaurant_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  /// Which assistant provider answers it (faq today).
  provider     String
  language     Language
  /// COLLECTING: the customer asked for a person and the next message is their problem.
  handoff      AssistantHandoff @default(NONE)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant         @relation("RestaurantAssistantSessions", fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User               @relation("UserAssistantSessions", fields: [userId], references: [id], onDelete: Cascade)
  messages   AssistantMessage[]
  tickets    SupportTicket[]

  @@index([userId, updatedAt])
  @@map("assistant_sessions")
}

/// One message in the unified format: a list of blocks (see AssistantBlock in contracts).
model AssistantMessage {
  id        String               @id @default(uuid()) @db.Uuid
  sessionId String               @map("session_id") @db.Uuid
  role      AssistantMessageRole
  provider  String
  blocks    Json
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  session AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("assistant_messages")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED

  @@map("support_ticket_status")
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("support_ticket_priority")
}

enum SupportMessageSide {
  CUSTOMER
  AGENT

  @@map("support_message_side")
}

enum SupportActivityKind {
  CREATED
  STATUS
  PRIORITY
  ASSIGNED
  REPLIED
  NOTE
  REOPENED

  @@map("support_activity_kind")
}

/// A restaurant's request to Bilhanah support, with its own lifecycle; BIL-{number}.
model SupportTicket {
  id                 String                @id @default(uuid()) @db.Uuid
  /// Shown as BIL-{number}; the sequence starts at 10001.
  number             Int                   @unique @default(autoincrement())
  restaurantId       String                @map("restaurant_id") @db.Uuid
  requesterId        String                @map("requester_id") @db.Uuid
  subject            String
  description        String
  topic              SupportTopic
  channel            SupportChannel        @default(FORM)
  priority           SupportTicketPriority @default(NORMAL)
  status             SupportTicketStatus   @default(OPEN)
  /// The dashboard page it is about, if any.
  module             String?
  faqArticleId       String?               @map("faq_article_id") @db.Uuid
  assistantSessionId String?               @map("assistant_session_id") @db.Uuid
  assigneeId         String?               @map("assignee_id") @db.Uuid
  firstResponseAt    DateTime?             @map("first_response_at") @db.Timestamptz(3)
  resolvedAt         DateTime?             @map("resolved_at") @db.Timestamptz(3)
  closedAt           DateTime?             @map("closed_at") @db.Timestamptz(3)
  lastActivityAt     DateTime              @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  /// When the restaurant last opened it / an agent last opened it (for unread markers).
  customerSeenAt     DateTime?             @map("customer_seen_at") @db.Timestamptz(3)
  agentSeenAt        DateTime?             @map("agent_seen_at") @db.Timestamptz(3)
  lastCustomerAt     DateTime              @default(now()) @map("last_customer_at") @db.Timestamptz(3)
  lastAgentAt        DateTime?             @map("last_agent_at") @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant       Restaurant              @relation("RestaurantSupportTickets", fields: [restaurantId], references: [id], onDelete: Cascade)
  requester        User                    @relation("SupportTicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee         User?                   @relation("SupportTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  faqArticle       FaqArticle?             @relation(fields: [faqArticleId], references: [id], onDelete: SetNull)
  assistantSession AssistantSession?       @relation(fields: [assistantSessionId], references: [id], onDelete: SetNull)
  messages         SupportMessage[]
  attachments      SupportAttachment[]
  assignments      SupportAssignment[]
  activity         SupportTicketActivity[]
  notifications    SupportNotification[]

  @@index([restaurantId, lastActivityAt])
  @@index([status, lastActivityAt])
  @@index([assigneeId, status])
  @@map("support_tickets")
}

/// A reply on a ticket; internal ones are notes between agents and never reach the restaurant.
model SupportMessage {
  id        String             @id @default(uuid()) @db.Uuid
  ticketId  String             @map("ticket_id") @db.Uuid
  authorId  String?            @map("author_id") @db.Uuid
  side      SupportMessageSide
  internal  Boolean            @default(false)
  body      String
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User?               @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// An image (screenshot) on a ticket or a reply, kept private and re-encoded as WebP. Unlinked uploads are purged.
model SupportAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  uploaderId   String?  @map("uploader_id") @db.Uuid
  /// The restaurant it was uploaded for (null for an agent's upload until it is linked).
  restaurantId String?  @map("restaurant_id") @db.Uuid
  ticketId     String?  @map("ticket_id") @db.Uuid
  messageId    String?  @map("message_id") @db.Uuid
  storageKey   String   @map("storage_key")
  fileName     String   @map("file_name")
  contentType  String   @map("content_type")
  bytes        Int
  width        Int
  height       Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  uploader User?           @relation("SupportAttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  ticket   SupportTicket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message  SupportMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([uploaderId, createdAt])
  @@map("support_attachments")
}

/// Every (re)assignment of a ticket: to whom, by whom, when.
model SupportAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  assigneeId   String?  @map("assignee_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee   User?         @relation("SupportAssignmentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedBy User?         @relation("SupportAssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_assignments")
}

/// The ticket's history: creation, status, priority, assignment, replies and notes.
model SupportTicketActivity {
  id        String              @id @default(uuid()) @db.Uuid
  ticketId  String              @map("ticket_id") @db.Uuid
  actorId   String?             @map("actor_id") @db.Uuid
  kind      SupportActivityKind
  from      String?
  to        String?
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?         @relation("SupportActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_ticket_activity")
}

enum SupportNotificationKind {
  TICKET_CREATED
  CUSTOMER_REPLIED
  TICKET_ASSIGNED
  NEEDS_ATTENTION
  AGENT_REPLIED
  STATUS_CHANGED
  TICKET_RESOLVED

  @@map("support_notification_kind")
}

/// An in-dashboard notification. One row per recipient, ticket and kind: a repeat event while it is unread
/// folds into it (count + 1) instead of piling up duplicates.
model SupportNotification {
  id           String                  @id @default(uuid()) @db.Uuid
  recipientId  String                  @map("recipient_id") @db.Uuid
  restaurantId String?                 @map("restaurant_id") @db.Uuid
  ticketId     String                  @map("ticket_id") @db.Uuid
  kind         SupportNotificationKind
  count        Int                     @default(1)
  readAt       DateTime?               @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipient User          @relation("SupportNotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([recipientId, ticketId, kind])
  @@index([recipientId, readAt, updatedAt])
  @@map("support_notifications")
}

/// Where a restaurant's menu lives (contracts: MENU_SOURCES).
enum MenuSource {
  BILHANAH
  EXTERNAL
  NONE
}

/// Where a record came from (contracts: DATA_SOURCES).
enum DataSource {
  BILHANAH
  EXTERNAL
}

/// The restaurant services (contracts: RESTAURANT_SERVICES).
enum RestaurantServiceKey {
  DIGITAL_MENU
  QR_ORDERING
  REVIEWS
  INVENTORY
  CASH_DRAWER
  ATTENDANCE
  LOYALTY
}

/// A service the restaurant switched on or off. No row: on (how every restaurant worked before services).
/// Switching a service off never deletes its data.
model RestaurantService {
  restaurantId String               @map("restaurant_id") @db.Uuid
  service      RestaurantServiceKey
  enabled      Boolean
  changedAt    DateTime             @default(now()) @updatedAt @map("changed_at") @db.Timestamptz(3)
  changedById  String?              @map("changed_by_id") @db.Uuid

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([restaurantId, service])
  @@map("restaurant_services")
}

/// Sign-in providers besides email and password (contracts: AUTH_PROVIDERS).
enum AuthProvider {
  GOOGLE
}

/// An account linked to a sign-in provider: Google's stable account id (`sub`), never its email, identifies it.
model UserIdentity {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  provider   AuthProvider
  /// The provider's id for the account (Google's `sub`).
  subject    String       @db.VarChar(255)
  /// The email the provider gave when it was linked (for support; the user's own email may change).
  email      String
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime     @default(now()) @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("user_identities")
}

// --- Loyalty (docs/LOYALTY.md) ------------------------------------------------

/// When an order's points are credited (contracts: LOYALTY_EARN_ON).
enum LoyaltyEarnOn {
  /// Served or handed over.
  COMPLETED
  /// Completed and its bill paid.
  PAID
}

enum LoyaltyRewardType {
  FIXED_DISCOUNT
  PERCENT_DISCOUNT
  FREE_PRODUCT
  FREE_ADDON
}

enum LoyaltyTransactionKind {
  /// An order reached the completion state.
  EARN
  /// Earned points taken back (the order was refunded).
  EARN_REVERSAL
  /// Points spent on a reward.
  REDEEM
  /// Spent points given back (the order was cancelled, rejected or refunded).
  REDEEM_RETURN
  /// The balance expired after a period without activity.
  EXPIRE
  /// Added or removed by the restaurant, with a reason.
  ADJUST
}

/// One restaurant's program. No row: the program is off.
model LoyaltySettings {
  restaurantId           String        @id @map("restaurant_id") @db.Uuid
  enabled                Boolean       @default(false)
  nameAr                 String?       @map("name_ar") @db.VarChar(40)
  nameEn                 String?       @map("name_en") @db.VarChar(40)
  /// `pointsPerUnit` points for every `spendUnitPiastres` of the bill (after discounts).
  pointsPerUnit          Int           @default(1) @map("points_per_unit")
  spendUnitPiastres      Int           @default(1000) @map("spend_unit_piastres")
  earnOn                 LoyaltyEarnOn @default(COMPLETED) @map("earn_on")
  /// The order types that earn and redeem points.
  orderTypes             OrderType[]   @default([DINE_IN, PICKUP]) @map("order_types")
  /// Orders below this bill earn nothing.
  minOrderPiastres       Int           @default(0) @map("min_order_piastres")
  /// A member needs at least this balance to redeem anything.
  minRedeemPoints        Int           @default(0) @map("min_redeem_points")
  /// A reward never takes more than this share of the subtotal.
  maxDiscountPercent     Int           @default(100) @map("max_discount_percent")
  /// A balance expires after this many days without earning or redeeming; null: never.
  expiryDays             Int?          @map("expiry_days")
  /// Reversal rules.
  cancelReturnsRedeemed  Boolean       @default(true) @map("cancel_returns_redeemed")
  refundReversesEarned   Boolean       @default(true) @map("refund_reverses_earned")
  refundReturnsRedeemed  Boolean       @default(true) @map("refund_returns_redeemed")
  tiersEnabled           Boolean       @default(false) @map("tiers_enabled")
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("loyalty_settings")
}

/// Optional tiers: a member reaches one by lifetime points and earns faster.
model LoyaltyTier {
  id                String   @id @default(uuid()) @db.Uuid
  restaurantId      String   @map("restaurant_id") @db.Uuid
  nameAr            String   @map("name_ar") @db.VarChar(30)
  nameEn            String?  @map("name_en") @db.VarChar(30)
  minLifetimePoints Int      @map("min_lifetime_points")
  /// 100 = the normal rate, 150 = one and a half times.
  earnMultiplier    Int      @default(100) @map("earn_multiplier")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rewards    LoyaltyReward[]

  @@unique([restaurantId, minLifetimePoints])
  @@map("loyalty_tiers")
}

model LoyaltyReward {
  id                  String            @id @default(uuid()) @db.Uuid
  restaurantId        String            @map("restaurant_id") @db.Uuid
  type                LoyaltyRewardType
  nameAr              String            @map("name_ar") @db.VarChar(80)
  nameEn              String?           @map("name_en") @db.VarChar(80)
  pointsCost          Int               @map("points_cost")
  /// FIXED_DISCOUNT: the amount off.
  amountPiastres      Int?              @map("amount_piastres")
  /// PERCENT_DISCOUNT: the share off, capped at maxDiscountPiastres when set.
  percent             Int?
  maxDiscountPiastres Int?              @map("max_discount_piastres")
  /// FREE_PRODUCT / FREE_ADDON: the dish (any size when variantId is null) one of which is free.
  menuItemId          String?           @map("menu_item_id") @db.Uuid
  variantId           String?           @map("variant_id") @db.Uuid
  /// The subtotal the order needs for the reward.
  minOrderPiastres    Int               @default(0) @map("min_order_piastres")
  /// How many times one member may redeem it; null: no limit.
  maxPerMember        Int?              @map("max_per_member")
  /// Only members of this tier or above.
  tierId              String?           @map("tier_id") @db.Uuid
  isActive            Boolean           @default(true) @map("is_active")
  sortOrder           Int               @default(0) @map("sort_order")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem     MenuItem?            @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  variant      MenuItemVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  tier         LoyaltyTier?         @relation(fields: [tierId], references: [id], onDelete: SetNull)
  orders       Order[]
  transactions LoyaltyTransaction[]

  @@index([restaurantId, sortOrder])
  @@map("loyalty_rewards")
}

/// A customer of one restaurant, known by phone. Never shared between restaurants.
model LoyaltyMember {
  id             String    @id @default(uuid()) @db.Uuid
  restaurantId   String    @map("restaurant_id") @db.Uuid
  phone          String    @db.VarChar(20)
  name           String    @db.VarChar(60)
  /// Kept up to date with every transaction (the ledger is the record; this is its sum).
  balance        Int       @default(0)
  /// Points earned (less reversals): what tiers go by.
  lifetimePoints Int       @default(0) @map("lifetime_points")
  /// The member card: bumping it invalidates every card issued before.
  passVersion    Int       @default(1) @map("pass_version")
  /// The order that created the membership (its checkout receives the first card).
  joinOrderId    String?   @map("join_order_id") @db.Uuid
  /// The last earning or redemption, for expiry.
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  transactions LoyaltyTransaction[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, lastActivityAt])
  @@map("loyalty_members")
}

/// The ledger: every change to a member's points, with why and the order behind it.
model LoyaltyTransaction {
  id           String                 @id @default(uuid()) @db.Uuid
  restaurantId String                 @map("restaurant_id") @db.Uuid
  memberId     String                 @map("member_id") @db.Uuid
  kind         LoyaltyTransactionKind
  /// Signed: positive adds to the balance.
  points       Int
  balanceAfter Int                    @map("balance_after")
  orderId      String?                @map("order_id") @db.Uuid
  rewardId     String?                @map("reward_id") @db.Uuid
  reason       String                 @db.VarChar(200)
  /// Who made it (adjustments and order changes by staff); null when automatic.
  actorId      String?                @map("actor_id") @db.Uuid
  actorName    String?                @map("actor_name") @db.VarChar(100)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  member     LoyaltyMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  order      Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reward     LoyaltyReward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  @@index([memberId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([orderId])
  @@map("loyalty_transactions")
}

// --- Point of sale (docs/POS.md) -----------------------------------------------------

/// Where an order was taken (contracts: ORDER_CHANNELS).
enum OrderChannel {
  MENU
  POS
}

/// What the administrator allows for a restaurant's POS.
enum PosAccess {
  ENABLED
  DISABLED
  SUSPENDED
}

enum PosMode {
  /// Bilhanah's own cashier terminal.
  BILHANAH
  /// The restaurant's existing POS, connected through an integration.
  EXTERNAL
  BOTH
}

/// Platform-wide: whether the POS is offered, and with which plans. One row (id 1).
model PosPlatformSettings {
  id        Int        @id @default(1)
  enabled   Boolean    @default(false)
  plans     PlanCode[] @default([ORDERS, ADVANCED])
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("pos_platform_settings")
}

/// One restaurant's POS: what the administrator allows, what the owner chose, and its settings.
model PosAccount {
  restaurantId              String    @id @map("restaurant_id") @db.Uuid
  access                    PosAccess @default(ENABLED)
  accessReason              String?   @map("access_reason") @db.VarChar(300)
  allowedModes              PosMode[] @default([BILHANAH, EXTERNAL]) @map("allowed_modes")
  mode                      PosMode?
  activatedAt               DateTime? @map("activated_at") @db.Timestamptz(3)
  setupCompletedAt          DateTime? @map("setup_completed_at") @db.Timestamptz(3)
  /// Basis points: 1400 = 14 %.
  taxRateBps                Int       @default(0) @map("tax_rate_bps")
  /// Menu prices already include the tax (it is shown, not added).
  taxInclusive              Boolean   @default(true) @map("tax_inclusive")
  serviceChargeBps          Int       @default(0) @map("service_charge_bps")
  /// Service charge on dine-in orders only.
  serviceChargeDineInOnly   Boolean   @default(true) @map("service_charge_dine_in_only")
  paymentMethods            OrderPaymentMethod[] @default([CASH, CARD]) @map("payment_methods")
  /// The largest discount a cashier may give without pos.discount (percent of the subtotal).
  cashierMaxDiscountPercent Int       @default(0) @map("cashier_max_discount_percent")
  /// The terminal takes cash only from a cashier with an open shift.
  requireOpenShift          Boolean   @default(true) @map("require_open_shift")
  receiptHeader             String?   @map("receipt_header") @db.VarChar(200)
  receiptFooter             String?   @map("receipt_footer") @db.VarChar(300)
  receiptShowLogo           Boolean   @default(true) @map("receipt_show_logo")
  /// How many POS devices may be ACTIVE or DISABLED at once (set by the platform administrator).
  maxDevices                Int       @default(3) @map("max_devices")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("pos_accounts")
}

// --- POS payments (task 3) -------------------------------------------------------------

enum PosPaymentStatus {
  SUCCEEDED
  PARTIALLY_REFUNDED
  REFUNDED
  /// Recorded for the record (a declined card); never counts towards the bill.
  FAILED
}

/// One payment towards an order's bill: an order may be paid in parts and by several methods.
model OrderPayment {
  id               String              @id @default(uuid()) @db.Uuid
  restaurantId     String              @map("restaurant_id") @db.Uuid
  orderId          String              @map("order_id") @db.Uuid
  branchId         String              @map("branch_id") @db.Uuid
  method           OrderPaymentMethod
  status           PosPaymentStatus
  amountPiastres   Int                 @map("amount_piastres")
  /// Cash handed over, and the change given back.
  tenderedPiastres Int?                @map("tendered_piastres")
  changePiastres   Int?                @map("change_piastres")
  refundedPiastres Int                 @default(0) @map("refunded_piastres")
  /// The card terminal's or wallet's reference (never card data), or the external POS transaction.
  reference        String?             @db.VarChar(100)
  failureReason    String?             @map("failure_reason") @db.VarChar(200)
  /// Recorded by an external POS through an integration.
  integrationId    String?             @map("integration_id") @db.Uuid
  cashierId        String?             @map("cashier_id") @db.Uuid
  cashierName      String?             @map("cashier_name") @db.VarChar(100)
  deviceId         String?             @map("device_id") @db.Uuid
  idempotencyKey   String              @map("idempotency_key") @db.VarChar(64)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  order   Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds OrderPaymentRefund[]

  @@unique([restaurantId, idempotencyKey])
  @@index([orderId])
  @@index([restaurantId, createdAt])
  @@map("order_payments")
}

/// A refund recorded against a payment, with why and who. Recording it does not move money at a provider.
model OrderPaymentRefund {
  id             String   @id @default(uuid()) @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  amountPiastres Int      @map("amount_piastres")
  reason         String   @db.VarChar(200)
  actorId        String?  @map("actor_id") @db.Uuid
  actorName      String?  @map("actor_name") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment OrderPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("order_payment_refunds")
}

// --- POS devices (task 5) ----------------------------------------------------------------

enum PosDeviceStatus {
  ACTIVE
  /// Paused by the owner or an administrator; can be switched back on.
  DISABLED
  /// Permanently withdrawn; its key never works again.
  REVOKED
}

/// A device registered to run the POS terminal; its key is shown once and stored hashed.
model PosDevice {
  id           String          @id @default(uuid()) @db.Uuid
  restaurantId String          @map("restaurant_id") @db.Uuid
  branchId     String          @map("branch_id") @db.Uuid
  name         String          @db.VarChar(60)
  /// sha256 of the device key (hex).
  keyHash      String          @unique @map("key_hash") @db.VarChar(64)
  status       PosDeviceStatus @default(ACTIVE)
  lastSeenAt   DateTime?       @map("last_seen_at") @db.Timestamptz(3)
  lastUserName String?         @map("last_user_name") @db.VarChar(100)
  createdById  String?         @map("created_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt    DateTime?       @map("revoked_at") @db.Timestamptz(3)
  /// sha256 of a short one-time code that pairs a new device (typed on it); cleared once used.
  pairingCodeHash  String?     @unique @map("pairing_code_hash") @db.VarChar(64)
  pairingExpiresAt DateTime?   @map("pairing_expires_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([restaurantId, status])
  @@map("pos_devices")
}

// --- External POS integrations (task 6) --------------------------------------------------

enum PosIntegrationStatus {
  ACTIVE
  PAUSED
  DISCONNECTED
}

/// A connection to the restaurant's external POS through a provider adapter (docs/POS.md).
model PosIntegration {
  id               String               @id @default(uuid()) @db.Uuid
  restaurantId     String               @map("restaurant_id") @db.Uuid
  provider         String               @db.VarChar(40)
  name             String               @db.VarChar(60)
  status           PosIntegrationStatus @default(ACTIVE)
  /// The branch it serves; null for every branch.
  branchId         String?              @map("branch_id") @db.Uuid
  /// Provider settings that are not secret (endpoint, what to sync).
  config           Json                 @default("{}")
  /// Provider secrets, sealed with the data key (never sent to a browser).
  credentialsSealed String              @map("credentials_sealed")
  lastSyncAt       DateTime?            @map("last_sync_at") @db.Timestamptz(3)
  lastTestAt       DateTime?            @map("last_test_at") @db.Timestamptz(3)
  lastTestOk       Boolean?             @map("last_test_ok")
  lastError        String?              @map("last_error") @db.VarChar(500)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  disconnectedAt   DateTime?            @map("disconnected_at") @db.Timestamptz(3)

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  mappings   PosMapping[]
  jobs       PosSyncJob[]
  events     PosWebhookEvent[]

  @@index([restaurantId, status])
  @@map("pos_integrations")
}

enum PosMappingEntity {
  BRANCH
  CATEGORY
  MENU_ITEM
  VARIANT
  ORDER
  PAYMENT
}

/// A Bilhanah record and its id in the external POS, unique both ways per integration.
model PosMapping {
  id            String           @id @default(uuid()) @db.Uuid
  integrationId String           @map("integration_id") @db.Uuid
  restaurantId  String           @map("restaurant_id") @db.Uuid
  entity        PosMappingEntity
  localId       String           @map("local_id") @db.Uuid
  externalId    String           @map("external_id") @db.VarChar(120)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  integration PosIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, entity, localId])
  @@unique([integrationId, entity, externalId])
  @@map("pos_mappings")
}

enum PosSyncJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  /// Out of retries, or refused by the provider: kept for a manual retry.
  DEAD
}

/// One operation sent to the external POS, retried with backoff until the provider confirms it.
model PosSyncJob {
  id             String           @id @default(uuid()) @db.Uuid
  integrationId  String           @map("integration_id") @db.Uuid
  restaurantId   String           @map("restaurant_id") @db.Uuid
  kind           String           @db.VarChar(40)
  entityId       String?          @map("entity_id") @db.Uuid
  idempotencyKey String           @map("idempotency_key") @db.VarChar(120)
  payload        Json
  status         PosSyncJobStatus @default(PENDING)
  attempts       Int              @default(0)
  maxAttempts    Int              @default(6) @map("max_attempts")
  nextRunAt      DateTime         @default(now()) @map("next_run_at") @db.Timestamptz(3)
  lastError      String?          @map("last_error") @db.VarChar(500)
  lastStatusCode Int?             @map("last_status_code")
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  integration PosIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, idempotencyKey])
  @@index([status, nextRunAt])
  @@index([integrationId, createdAt])
  @@map("pos_sync_jobs")
}

/// Every webhook received from an external POS: verified, processed once, logged.
model PosWebhookEvent {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @map("integration_id") @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  eventId       String   @map("event_id") @db.VarChar(120)
  type          String   @db.VarChar(60)
  /// PROCESSED, IGNORED or FAILED.
  outcome       String   @db.VarChar(20)
  error         String?  @db.VarChar(500)
  payload       Json
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  integration PosIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, eventId])
  @@index([integrationId, receivedAt])
  @@map("pos_webhook_events")
}
