enum RecommendationType {
  FREQUENTLY_BOUGHT_TOGETHER
  ADD_ON
  UPGRADE
  ALTERNATIVE

  @@map("recommendation_type")
}

enum RecommendationPlacement {
  PRODUCT_DETAILS
/// How a menu size's portion is measured.
enum PortionUnit {
  GRAM
  ML
  PIECE

  @@map("portion_unit")
}

  CART
  CHECKOUT

  @@map("recommendation_placement")
}

enum RecommendationEventKind {
  IMPRESSION
  CLICK
  ADD

  @@map("recommendation_event_kind")
}

/// What the restaurant suggests with a dish (bought together, add-ons, an upgrade, alternatives) and where diners see it.
model RecommendationRule {
  id           String                    @id @default(uuid()) @db.Uuid
  restaurantId String                    @map("restaurant_id") @db.Uuid
  sourceItemId String                    @map("source_item_id") @db.Uuid
  type         RecommendationType
  placements   RecommendationPlacement[]
  /// Shown above the suggestions instead of the type's default heading.
  title        String?                   @db.VarChar(60)
  /// Add-ons on the dish page only: the diner picks at least one before adding the dish (while any is available).
  required     Boolean                   @default(false)
  isActive     Boolean                   @default(true) @map("is_active")
  sortOrder    Int                       @map("sort_order")
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sourceItem MenuItem                 @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  items      RecommendationRuleItem[]
  events     RecommendationEvent[]
  orderItems OrderItem[]

  @@index([restaurantId, sortOrder])
  @@index([sourceItemId])
  @@map("recommendation_rules")
}

/// One suggested dish of a rule: a size (or the diner's choice when null) and how many may be added.
model RecommendationRuleItem {
  id          String  @id @default(uuid()) @db.Uuid
  ruleId      String  @map("rule_id") @db.Uuid
  itemId      String  @map("item_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  maxQuantity Int     @default(1) @map("max_quantity") @db.SmallInt
  sortOrder   Int     @map("sort_order")

  rule    RecommendationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  item    MenuItem           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variant MenuItemVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([ruleId, sortOrder])
  @@index([itemId])
  @@map("recommendation_rule_items")
}

/// A diner saw, opened or added a suggestion (purchases are the order lines that carry a rule).
model RecommendationEvent {
  id           String                  @id @default(uuid()) @db.Uuid
  restaurantId String                  @map("restaurant_id") @db.Uuid
  branchId     String?                 @map("branch_id") @db.Uuid
  ruleId       String?                 @map("rule_id") @db.Uuid
  itemId       String                  @map("item_id") @db.Uuid
  kind         RecommendationEventKind
  placement    RecommendationPlacement
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  rule       RecommendationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([ruleId, kind])
  @@map("recommendation_events")
}

enum ServiceRequestType {
  CALL_WAITER
  REQUEST_BILL
  REQUEST_WATER
  REQUEST_NAPKINS
  REQUEST_CLEANING
  CUSTOM

  @@map("service_request_type")
}

enum ServiceRequestStatus {
  PENDING
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("service_request_status")
}

/// The guests at one table, from the first scan until the bill is settled (or it goes idle).
/// Everyone at the table shares it; their service requests belong to it.
model TableSession {
  id             String                   @id @default(uuid()) @db.Uuid
  restaurantId   String                   @map("restaurant_id") @db.Uuid
  branchId       String                   @map("branch_id") @db.Uuid
  tableId        String                   @map("table_id") @db.Uuid
  /// At most one session that is not CLOSED per table (partial unique index in SQL).
  status         TableSessionStatus       @default(ACTIVE)
  closedReason   TableSessionCloseReason? @map("closed_reason")
  startedAt      DateTime                 @default(now()) @map("started_at") @db.Timestamptz(3)
  lastActivityAt DateTime                 @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  /// Set with status CLOSED.
  endedAt        DateTime?                @map("ended_at") @db.Timestamptz(3)
  /// Bumped on every change to its guests, dishes or status.
  version        Int                      @default(0)

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table      Table            @relation(fields: [tableId], references: [id], onDelete: Cascade)
  requests   ServiceRequest[]
  guests     TableGuest[]
  cartItems  TableCartItem[]
  orders     Order[]

  @@index([tableId, endedAt])
  @@index([restaurantId])
  @@index([branchId, status])
  @@map("table_sessions")
}

/// A diner's request to the staff (call a waiter, bring the bill, water, ...), with who handles it and when.
model ServiceRequest {
  id               String               @id @default(uuid()) @db.Uuid
  restaurantId     String               @map("restaurant_id") @db.Uuid
  branchId         String               @map("branch_id") @db.Uuid
  /// Null once the table is deleted; the label stays.
  tableId          String?              @map("table_id") @db.Uuid
  tableLabel       String               @map("table_label") @db.VarChar(40)
  sessionId        String               @map("session_id") @db.Uuid
  type             ServiceRequestType
  status           ServiceRequestStatus @default(PENDING)
  note             String?              @db.VarChar(200)
  assignedToId     String?              @map("assigned_to_id") @db.Uuid
  assignedAt       DateTime?            @map("assigned_at") @db.Timestamptz(3)
  /// The last staff member who changed it.
  handledById      String?              @map("handled_by_id") @db.Uuid
  acknowledgedAt   DateTime?            @map("acknowledged_at") @db.Timestamptz(3)
  startedAt        DateTime?            @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?            @map("completed_at") @db.Timestamptz(3)
  cancelledAt      DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  /// The guests withdrew it themselves (rather than the staff cancelling it).
  cancelledByGuest Boolean              @default(false) @map("cancelled_by_guest")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table      Table?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  session    TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignedTo User?        @relation("ServiceRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  handledBy  User?        @relation("ServiceRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([branchId, status, createdAt])
  @@index([restaurantId, createdAt])
  @@index([tableId, type, createdAt])
  @@index([sessionId])
  @@map("service_requests")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("reservation_status")
}

/// A booking taken by staff: who, when, how many, and (optionally) which table.
model Reservation {
  id            String            @id @default(uuid()) @db.Uuid
  restaurantId  String            @map("restaurant_id") @db.Uuid
  branchId      String            @map("branch_id") @db.Uuid
  tableId       String?           @map("table_id") @db.Uuid
  customerName  String            @map("customer_name") @db.VarChar(80)
  customerPhone String?           @map("customer_phone") @db.VarChar(20)
  guests        Int               @db.SmallInt
  reservedAt    DateTime          @map("reserved_at") @db.Timestamptz(3)
  status        ReservationStatus @default(CONFIRMED)
  notes         String?           @db.VarChar(300)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table      Table?     @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([branchId, reservedAt])
  @@index([tableId, reservedAt])
  @@map("reservations")
}

enum OrderType {
  DINE_IN
  PICKUP

  @@map("order_type")
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  REJECTED
  CANCELLED

  @@map("order_status")
}

/// An order placed by a diner. Names and prices are copied at placement, so menu edits never change it.
model Order {
  id               String              @id @default(uuid()) @db.Uuid
  restaurantId     String              @map("restaurant_id") @db.Uuid
  /// The branch that receives and prepares the order.
  branchId         String              @map("branch_id") @db.Uuid
  /// Daily sequence per branch (restaurant time zone): #1, #2, ...
  number           Int
  /// The restaurant's local date the number belongs to.
  businessDay      DateTime            @map("business_day") @db.Date
  type             OrderType
  tableId          String?             @map("table_id") @db.Uuid
  /// Kept even if the table is renamed or deleted.
  tableLabel       String?             @map("table_label") @db.VarChar(40)
  customerName     String              @map("customer_name") @db.VarChar(60)
  customerPhone    String?             @map("customer_phone") @db.VarChar(20)
  note             String?             @db.VarChar(300)
  status           OrderStatus         @default(PLACED)
  subtotalPiastres Int                 @map("subtotal_piastres")
  /// Client-generated key; a retried submission returns the same order.
  idempotencyKey   String              @map("idempotency_key") @db.VarChar(64)
  rejectionReason  String?             @map("rejection_reason") @db.VarChar(300)
  placedAt         DateTime            @default(now()) @map("placed_at") @db.Timestamptz(3)
  acceptedAt       DateTime?           @map("accepted_at") @db.Timestamptz(3)
  readyAt          DateTime?           @map("ready_at") @db.Timestamptz(3)
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz(3)
  closedAt         DateTime?           @map("closed_at") @db.Timestamptz(3)
  /// The restaurant marked the bill paid. A dine-in order not yet paid keeps its table occupied.
  paidAt           DateTime?           @map("paid_at") @db.Timestamptz(3)
  /// How the bill was paid; null while unpaid. Only CASH reaches a cashier's drawer.
  paymentMethod    OrderPaymentMethod? @map("payment_method")
  /// The shared table session it was sent from (or that was open at the table when placed).
  tableSessionId   String?             @map("table_session_id") @db.Uuid
  /// When the diner can expect it ready, set by the restaurant on accepting (or while preparing).
  estimatedReadyAt DateTime?           @map("estimated_ready_at") @db.Timestamptz(3)
  /// The first time the diner opened the tracking page (for tracking usage).
  trackedAt        DateTime?           @map("tracked_at") @db.Timestamptz(3)
  /// A "ready" notification reached at least one of the diner's browsers.
  readyNotifiedAt  DateTime?           @map("ready_notified_at") @db.Timestamptz(3)
  /// Rush orders go to the top of the kitchen display.
  priority         OrderPriority       @default(NORMAL)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant        Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table             Table?             @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  pushSubscriptions PushSubscription[]
  statusEvents      OrderStatusEvent[]
  itemEvents        OrderItemEvent[]
  cashTransactions  CashTransaction[]
  tableSession      TableSession?      @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  tableCartItems    TableCartItem[]

  @@unique([restaurantId, idempotencyKey])
  @@unique([branchId, businessDay, number])
  @@index([restaurantId, status, placedAt])
  @@index([restaurantId, placedAt])
  @@index([branchId, status, placedAt])
  @@index([branchId, tableId, paidAt])
  @@index([tableSessionId])
  @@map("orders")
}

model OrderItem {
  id                      String                   @id @default(uuid()) @db.Uuid
  orderId                 String                   @map("order_id") @db.Uuid
  /// The menu item, while it still exists; the names and price below are copies.
  menuItemId              String?                  @map("menu_item_id") @db.Uuid
  nameAr                  String                   @map("name_ar") @db.VarChar(100)
  nameEn                  String?                  @map("name_en") @db.VarChar(100)
  variantNameAr           String?                  @map("variant_name_ar") @db.VarChar(40)
  variantNameEn           String?                  @map("variant_name_en") @db.VarChar(40)
  unitPricePiastres       Int                      @map("unit_price_piastres")
  quantity                Int
  note                    String?                  @db.VarChar(200)
  sortOrder               Int                      @map("sort_order")
  /// Added from a recommendation (checked when the order was placed), for its revenue and conversion.
  recommendationRuleId    String?                  @map("recommendation_rule_id") @db.Uuid
  recommendationPlacement RecommendationPlacement? @map("recommendation_placement")
  /// The kitchen station it was routed to when placed (null: the default station); the name is a copy.
  stationId               String?                  @map("station_id") @db.Uuid
  stationName             String?                  @map("station_name") @db.VarChar(40)
  /// Inventory WARN policy: dishes whose recipe the branch's stock could not cover when it was placed.
  lowStockItemIds  String[]            @default([]) @map("low_stock_item_ids") @db.Uuid
  /// When its recipes were deducted from stock (inventory deductOn reached); null until then.
  stockDeductedAt  DateTime?           @map("stock_deducted_at") @db.Timestamptz(3)
  /// Preparation on the kitchen display, with when it reached each step.
  prepStatus              OrderItemStatus          @default(NEW) @map("prep_status")
  acceptedAt              DateTime?                @map("accepted_at") @db.Timestamptz(3)
  startedAt               DateTime?                @map("started_at") @db.Timestamptz(3)
  readyAt                 DateTime?                @map("ready_at") @db.Timestamptz(3)
  servedAt                DateTime?                @map("served_at") @db.Timestamptz(3)
  cancelledAt             DateTime?                @map("cancelled_at") @db.Timestamptz(3)
  /// Who added it in a shared table session; the name is a copy.
  guestId                 String?                  @map("guest_id") @db.Uuid
  guestName               String?                  @map("guest_name") @db.VarChar(30)

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  guest              TableGuest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  menuItem           MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  recommendationRule RecommendationRule? @relation(fields: [recommendationRuleId], references: [id], onDelete: SetNull)
  station            KitchenStation?     @relation(fields: [stationId], references: [id], onDelete: SetNull)
  events             OrderItemEvent[]

  @@index([orderId])
  @@index([stationId])
  @@map("order_items")
}

enum OrderItemStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED

  @@map("order_item_status")
}

enum OrderPriority {
  NORMAL
  RUSH

  @@map("order_priority")
}

enum KitchenReadyRule {
  /// The order turns ready once every dish (not cancelled) is ready.
  ALL_ITEMS
  /// Only someone marking the whole order ready does.
  MANUAL

  @@map("kitchen_ready_rule")
}

enum KitchenStationKind {
  MAIN
  GRILL
  DRINKS
  /// The size ordered, while it still exists (its recipe is what the line deducts).
  variantId               String?                  @map("variant_id") @db.Uuid
  /// What the line's ingredients cost (whole line, all its quantity), set when the order is accepted
  /// and its stock deducted; null without a recipe or inventory.
  costPiastres            Int?                     @map("cost_piastres")
  DESSERTS
  COLD
  BAKERY
  OTHER
  variant            MenuItemVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  stockMovements     StockMovement[]

  @@map("kitchen_station_kind")
}

/// Where dishes are prepared (main kitchen, grill, drinks, desserts...). Each station's screen sees only its dishes.
model KitchenStation {
  id            String             @id @default(uuid()) @db.Uuid
  restaurantId  String             @map("restaurant_id") @db.Uuid
  nameAr        String             @map("name_ar") @db.VarChar(40)
  nameEn        String?            @map("name_en") @db.VarChar(40)
  kind          KitchenStationKind @default(OTHER)
  /// Minutes a dish here usually takes; past it, the order shows as late.
  targetMinutes Int                @default(15) @map("target_minutes") @db.SmallInt
  /// Dishes with no station (theirs or their category's) go here. Exactly one per restaurant.
  isDefault     Boolean            @default(false) @map("is_default")
  isActive      Boolean            @default(true) @map("is_active")
  sortOrder     Int                @map("sort_order")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories Category[]
  menuItems  MenuItem[]
  orderItems OrderItem[]

  @@index([restaurantId, sortOrder])
  @@map("kitchen_stations")
}

/// Each preparation step of an order line on the kitchen display: who moved it, where, and when.
model OrderItemEvent {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @map("order_id") @db.Uuid
  orderItemId String          @map("order_item_id") @db.Uuid
  status      OrderItemStatus
  actorId     String?         @map("actor_id") @db.Uuid
  actorName   String?         @map("actor_name") @db.VarChar(100)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  actor User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([orderItemId, createdAt])
  @@map("order_item_events")
}

/// The last order number used per branch and business day.
model OrderCounter {
  branchId    String   @map("branch_id") @db.Uuid
  businessDay DateTime @map("business_day") @db.Date
  lastNumber  Int      @map("last_number")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([branchId, businessDay])
  @@map("order_counters")
}

/// A diner's browser asking to hear about one order (Web Push). Deleted once
/// the order is finished, or when the push service says it is gone.
/// The status history of an order: who moved it where, and when.
model OrderStatusEvent {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  /// The staff account that made the change; null when the diner placed the order (or the account is gone).
  actorId   String?     @map("actor_id") @db.Uuid
  /// Kept when the account is removed.
  actorName String?     @map("actor_name") @db.VarChar(100)
  reason    String?     @db.VarChar(300)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

enum OrderPushUpdates {
  /// Ready, rejected and cancelled.
  READY
  /// Also accepted and preparing.
  ALL

  @@map("order_push_updates")
}

model PushSubscription {
  id        String           @id @default(uuid()) @db.Uuid
  orderId   String           @map("order_id") @db.Uuid
  endpoint  String           @db.VarChar(2048)
  /// The browser's keys for encrypting messages (base64url).
  p256dh    String           @db.VarChar(100)
  auth      String           @db.VarChar(32)
  /// Notifications are written in the language the diner's page used.
  language  Language         @default(ar)
  /// What the diner asked to hear about: the order turning ready (or not coming), or every step.
  updates   OrderPushUpdates @default(READY)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, endpoint])
  @@index([createdAt])
  @@map("push_subscriptions")
}

// --- Stand shop ---------------------------------------------------------------

enum StandOrderStatus {
  /// Online order whose payment is not finished; cancelled after two days.
  AWAITING_PAYMENT
  NEW
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("stand_order_status")
}

enum StandPaymentMethod {
  CASH_ON_DELIVERY
  PAYMOB

  @@map("stand_payment_method")
}

enum StandPaymentStatus {
  UNPAID
  PAID

  @@map("stand_payment_status")
}

/// What the stand-shop checkout offers; edited by administrators. A single row with id 1.
model ShopSettings {
  id                  Int      @id @default(1)
  /// Flat delivery fee; null when it is confirmed by phone.
  deliveryFeePiastres Int?     @map("delivery_fee_piastres")
  cashOnDelivery      Boolean  @default(true) @map("cash_on_delivery")
  onlinePayment       Boolean  @default(true) @map("online_payment")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("shop_settings")
}

/// A logo uploaded at checkout. Unused ones are deleted after two days.
model StandLogo {
  id         String   @id @default(uuid()) @db.Uuid
  storageKey String   @map("storage_key") @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lines StandOrderLine[]

  @@index([createdAt])
  @@map("stand_logos")
}

/// An order from the stand shop; customers need no account.
model StandOrder {
  id                  String             @id @default(uuid()) @db.Uuid
  /// Shown as "S-<number>".
  number              Int                @unique @default(autoincrement())
  status              StandOrderStatus
  paymentMethod       StandPaymentMethod @map("payment_method")
  paymentStatus       StandPaymentStatus @default(UNPAID) @map("payment_status")
  paidAt              DateTime?          @map("paid_at") @db.Timestamptz(3)
  customerName        String             @map("customer_name") @db.VarChar(80)
  phone               String             @db.VarChar(20)
  email               String?            @db.VarChar(254)
  city                String             @db.VarChar(60)
  address             String             @db.VarChar(300)
  customerNotes       String?            @map("customer_notes") @db.VarChar(500)
  adminNote           String?            @map("admin_note") @db.VarChar(1000)
  language            Language           @default(ar)
  subtotalPiastres    Int                @map("subtotal_piastres")
  /// Null when the fee is confirmed by phone.
  deliveryFeePiastres Int?               @map("delivery_fee_piastres")
  totalPiastres       Int                @map("total_piastres")
  /// Client-generated; a retried checkout returns the same order.
  idempotencyKey      String             @unique @map("idempotency_key") @db.VarChar(64)
  paymobOrderId       String?            @map("paymob_order_id") @db.VarChar(40)
  paymobTransactionId String?            @unique @map("paymob_transaction_id") @db.VarChar(40)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines  StandOrderLine[]
  events StandOrderEvent[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("stand_orders")
}

model StandOrderLine {
  id                String  @id @default(uuid()) @db.Uuid
  orderId           String  @map("order_id") @db.Uuid
  sortOrder         Int     @map("sort_order")
  /// "stand" or "sticker".
  product           String  @default("stand") @db.VarChar(20)
  shape             String  @db.VarChar(20)
  nfc               Boolean
  design            String  @db.VarChar(20)
  customBackground  String? @map("custom_background") @db.VarChar(7)
  customInk         String? @map("custom_ink") @db.VarChar(7)
  purpose           String  @db.VarChar(20)
  brand             String  @db.VarChar(35)
  caption           String  @db.VarChar(60)
  url               String  @db.VarChar(2048)
  logoId            String? @map("logo_id") @db.Uuid
  numbered          Boolean
  startNumber       Int     @map("start_number")
  quantity          Int
  notes             String  @db.VarChar(300)
  unitPricePiastres Int     @map("unit_price_piastres")

  order StandOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  logo  StandLogo? @relation(fields: [logoId], references: [id], onDelete: SetNull)

  @@index([orderId, sortOrder])
  @@map("stand_order_lines")
}

/// The order's history: every status change, by whom (null: the customer, Paymob or the system).
model StandOrderEvent {
  id        String           @id @default(uuid()) @db.Uuid
  orderId   String           @map("order_id") @db.Uuid
  status    StandOrderStatus
  note      String?          @db.VarChar(300)
  actorId   String?          @map("actor_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  order StandOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("stand_order_events")
}

// --- Analytics ----------------------------------------------------------------

/// Menu visits per restaurant and day (restaurant time zone), copied from Redis counters by the worker.
model RestaurantDailyStat {
  restaurantId String   @map("restaurant_id") @db.Uuid
  day          DateTime @db.Date
  visits       Int      @default(0)
  qrVisits     Int      @default(0) @map("qr_visits")
  tableVisits  Int      @default(0) @map("table_visits")
  linkVisits   Int      @default(0) @map("link_visits")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([restaurantId, day])
  @@index([day])
  @@map("restaurant_daily_stats")
}

// --- Staff attendance -------------------------------------------------------------------------------

enum AttendanceMethod {
  /// The employee signs in to their dashboard and taps check in.
  PORTAL
  /// The employee, signed in, scans the branch's QR code.
  QR
  /// A shared branch screen: employee number and PIN.
  KIOSK
  /// A registered USB fingerprint device (through its local service).
  FINGERPRINT
  /// Entered by a manager (on someone's behalf, or a correction).
  MANUAL

  @@map("attendance_method")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  INCOMPLETE
  EARLY_LEAVE
  OVERTIME
  PENDING_CORRECTION

  @@map("attendance_status")
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT

  @@map("attendance_event_type")
}

enum AttendanceQrMode {
  STATIC
  DYNAMIC

  @@map("attendance_qr_mode")
}

enum AttendanceLocationMode {
  OFF
  /// Outside the radius (or no location): recorded, but flagged for review.
  FLAG
  /// Outside the radius (or no location): refused.
  REJECT

  @@map("attendance_location_mode")
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("correction_status")
}

/// Someone whose attendance is tracked. May have no dashboard account (PIN or fingerprint only), or be linked to a staff account (then they can use the employee portal and QR).
model Employee {
  id             String    @id @default(uuid()) @db.Uuid
  restaurantId   String    @map("restaurant_id") @db.Uuid
  /// The branch they work at.
  branchId       String    @map("branch_id") @db.Uuid
  /// The number they type at the kiosk; unique in the restaurant.
  employeeNumber String    @map("employee_number") @db.VarChar(12)
  fullName       String    @map("full_name") @db.VarChar(100)
  jobTitle       String?   @map("job_title") @db.VarChar(60)
  phone          String?   @db.VarChar(20)
  /// Their staff account, if any (one employee per account).
  userId         String?   @unique @map("user_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  hireDate       DateTime? @map("hire_date") @db.Date
  /// Kiosk PIN (argon2id); never shown. A reset PIN must be changed by the employee.
  pinHash        String?   @map("pin_hash")
  pinMustChange  Boolean   @default(true) @map("pin_must_change")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant  Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch      Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user        User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  shifts      Shift[]
  records     AttendanceRecord[]
  events      AttendanceEvent[]
  corrections AttendanceCorrection[]

  @@unique([restaurantId, employeeNumber])
  @@index([branchId])
  @@map("employees")
}

/// How attendance works at a restaurant (branchId null) or one branch (overrides the restaurant's).
model AttendancePolicy {
  id                  String                 @id @default(uuid()) @db.Uuid
  restaurantId        String                 @map("restaurant_id") @db.Uuid
  branchId            String?                @unique @map("branch_id") @db.Uuid
  /// A branch row that follows the restaurant's rules (it then only holds the branch's QR code and secret).
  inherits            Boolean                @default(true)
  methods             AttendanceMethod[]     @default([PORTAL])
  primaryMethod       AttendanceMethod       @default(PORTAL) @map("primary_method")
  graceMinutes        Int                    @default(10) @map("grace_minutes") @db.SmallInt
  earlyCheckInMinutes Int                    @default(30) @map("early_check_in_minutes") @db.SmallInt
  lateCheckOutMinutes Int                    @default(60) @map("late_check_out_minutes") @db.SmallInt
  recordOvertime      Boolean                @default(true) @map("record_overtime")
  allowWithoutShift   Boolean                @default(false) @map("allow_without_shift")
  allowOutsideShift   Boolean                @default(false) @map("allow_outside_shift")
  allowMultipleShifts Boolean                @default(false) @map("allow_multiple_shifts")
  requireCheckOut     Boolean                @default(true) @map("require_check_out")
  correctionsEnabled  Boolean                @default(true) @map("corrections_enabled")
  /// Managers' manual edits wait for the owner's approval.
  manualNeedsApproval Boolean                @default(false) @map("manual_needs_approval")
  qrMode              AttendanceQrMode       @default(DYNAMIC) @map("qr_mode")
  qrTtlSeconds        Int                    @default(30) @map("qr_ttl_seconds") @db.SmallInt
  /// The branch's printed QR code (static mode); regenerating it retires printed copies.
  qrStaticCode        String?                @unique @map("qr_static_code") @db.VarChar(32)
  /// Signs the dynamic QR codes; rotating it invalidates them all.
  qrSecret            String?                @map("qr_secret") @db.VarChar(64)
  qrEnabled           Boolean                @default(true) @map("qr_enabled")
  locationMode        AttendanceLocationMode @default(OFF) @map("location_mode")
  latitude            Float?
  longitude           Float?
  radiusMeters        Int?                   @map("radius_meters")
  updatedById         String?                @map("updated_by_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("attendance_policies")
}

/// One employee's shift on one day (a leave day when isLeave).
model Shift {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  /// The restaurant's local date the shift starts on.
  day          DateTime @db.Date
  startsAt     DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime @map("ends_at") @db.Timestamptz(3)
  isLeave      Boolean  @default(false) @map("is_leave")
  name         String?  @db.VarChar(40)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  records    AttendanceRecord[]

  @@index([restaurantId, day])
  @@index([employeeId, day])
  @@map("shifts")
}

/// One attendance session: a check-in and (once there) its check-out, with its calculated status.
model AttendanceRecord {
  id                String            @id @default(uuid()) @db.Uuid
  restaurantId      String            @map("restaurant_id") @db.Uuid
  branchId          String            @map("branch_id") @db.Uuid
  employeeId        String            @map("employee_id") @db.Uuid
  shiftId           String?           @map("shift_id") @db.Uuid
  day               DateTime          @db.Date
  checkInAt         DateTime          @map("check_in_at") @db.Timestamptz(3)
  checkOutAt        DateTime?         @map("check_out_at") @db.Timestamptz(3)
  status            AttendanceStatus  @default(PRESENT)
  workedMinutes     Int               @default(0) @map("worked_minutes")
  lateMinutes       Int               @default(0) @map("late_minutes")
  earlyLeaveMinutes Int               @default(0) @map("early_leave_minutes")
  overtimeMinutes   Int               @default(0) @map("overtime_minutes")
  checkInMethod     AttendanceMethod  @map("check_in_method")
  checkOutMethod    AttendanceMethod? @map("check_out_method")
  kioskId           String?           @map("kiosk_id") @db.Uuid
  /// Location check failed (or was refused) under the FLAG policy.
  flagged           Boolean           @default(false)
  managerNote       String?           @map("manager_note") @db.VarChar(300)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant  Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch      Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift       Shift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  kiosk       AttendanceKiosk?       @relation(fields: [kioskId], references: [id], onDelete: SetNull)
  events      AttendanceEvent[]
  corrections AttendanceCorrection[]

  @@index([restaurantId, day])
  @@index([employeeId, day])
  @@map("attendance_records")
}

/// A single check-in or check-out, as it happened. Never edited; corrections add records' changes to the audit log.
model AttendanceEvent {
  id             String              @id @default(uuid()) @db.Uuid
  restaurantId   String              @map("restaurant_id") @db.Uuid
  employeeId     String              @map("employee_id") @db.Uuid
  recordId       String              @map("record_id") @db.Uuid
  type           AttendanceEventType
  at             DateTime            @db.Timestamptz(3)
  method         AttendanceMethod
  kioskId        String?             @map("kiosk_id") @db.Uuid
  /// The client's key for this event; a retried request records nothing new.
  idempotencyKey String?             @map("idempotency_key") @db.VarChar(64)
  /// Distance from the branch, flag reasons... never biometric data.
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  record   AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, idempotencyKey])
  @@index([recordId])
  @@map("attendance_events")
}

/// A shared branch screen for PIN attendance. Activated once with a code; then holds its own token.
model AttendanceKiosk {
  id                  String    @id @default(uuid()) @db.Uuid
  restaurantId        String    @map("restaurant_id") @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  name                String    @db.VarChar(60)
  /// One-time code typed on the kiosk screen to activate it (hashed); cleared once used.
  activationCodeHash  String?   @map("activation_code_hash") @db.VarChar(64)
  activationExpiresAt DateTime? @map("activation_expires_at") @db.Timestamptz(3)
  /// The kiosk's long-lived credential (SHA-256 of it).
  tokenHash           String?   @unique @map("token_hash") @db.VarChar(64)
  activatedAt         DateTime? @map("activated_at") @db.Timestamptz(3)
  lastSeenAt          DateTime? @map("last_seen_at") @db.Timestamptz(3)
  disabledAt          DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  records    AttendanceRecord[]

  @@index([restaurantId])
  @@map("attendance_kiosks")
}

/// An employee asking to fix a forgotten check-in or check-out; a manager approves or rejects it.
model AttendanceCorrection {
  id                String           @id @default(uuid()) @db.Uuid
  restaurantId      String           @map("restaurant_id") @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  recordId          String?          @map("record_id") @db.Uuid
  day               DateTime         @db.Date
  requestedCheckIn  DateTime?        @map("requested_check_in") @db.Timestamptz(3)
  requestedCheckOut DateTime?        @map("requested_check_out") @db.Timestamptz(3)
  reason            String           @db.VarChar(300)
  status            CorrectionStatus @default(PENDING)
  reviewedById      String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  reviewNote        String?          @map("review_note") @db.VarChar(300)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  record     AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  reviewedBy User?             @relation("AttendanceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([restaurantId, status])
  @@index([employeeId])
  @@map("attendance_corrections")
}

// --- Cashier shifts and cash reconciliation --------------------------------------------------------

enum OrderPaymentMethod {
  CASH
  CARD
  WALLET
  OTHER

  @@map("order_payment_method")
}

enum CashShiftStatus {
  OPEN
  /// The cashier is counting: no new cash movements; back to OPEN or on to CLOSED.
  CLOSING
  CLOSED

  @@map("cash_shift_status")
}

enum CashReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED

  @@map("cash_review_status")
}

enum CashTransactionKind {
  SALE
  REFUND
  CASH_IN
  CASH_OUT
  ADJUSTMENT
  CORRECTION

  @@map("cash_transaction_kind")
}

enum CashApprovalStatus {
  APPROVED
  PENDING
  REJECTED

  @@map("cash_approval_status")
}

enum ClosingNoteRule {
  NEVER
  ON_DISCREPANCY
  ALWAYS

  @@map("closing_note_rule")
}

/// A restaurant's reconciliation rules (defaults when missing: contracts DEFAULT_CASH_SETTINGS).
model CashSettings {
  restaurantId                 String          @id @map("restaurant_id") @db.Uuid
  allowSharedRegister          Boolean         @default(false) @map("allow_shared_register")
  requireShiftForCash          Boolean         @default(false) @map("require_shift_for_cash")
  adjustmentsNeedApproval      Boolean         @default(true) @map("adjustments_need_approval")
  discrepancyTolerancePiastres Int             @default(0) @map("discrepancy_tolerance_piastres")
  closingNote                  ClosingNoteRule @default(ON_DISCREPANCY) @map("closing_note")
  /// ISO 4217; every price in Bilhanah is in Egyptian piastres today.
  currency                     String          @default("EGP") @db.Char(3)
  updatedById                  String?         @map("updated_by_id") @db.Uuid
  updatedAt                    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("cash_settings")
}

/// A cash drawer at a branch. Archived registers keep their shifts.
model CashRegister {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  name         String   @db.VarChar(40)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shifts     CashShift[]

  @@unique([branchId, name])
  @@index([restaurantId])
  @@map("cash_registers")
}

/// One cashier's shift on a drawer, from the opening cash to the count at closing.
/// At most one active (OPEN or CLOSING) shift per cashier (partial unique index in SQL).
model CashShift {
  id                  String            @id @default(uuid()) @db.Uuid
  restaurantId        String            @map("restaurant_id") @db.Uuid
  branchId            String            @map("branch_id") @db.Uuid
  registerId          String?           @map("register_id") @db.Uuid
  /// Null once the account is deleted; cashierName keeps who it was.
  cashierId           String?           @map("cashier_id") @db.Uuid
  cashierName         String            @map("cashier_name") @db.VarChar(100)
  status              CashShiftStatus   @default(OPEN)
  currency            String            @default("EGP") @db.Char(3)
  openingPiastres     Int               @map("opening_piastres")
  openingNote         String?           @map("opening_note") @db.VarChar(500)
  openedAt            DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  closingStartedAt    DateTime?         @map("closing_started_at") @db.Timestamptz(3)
  closedAt            DateTime?         @map("closed_at") @db.Timestamptz(3)
  closedById          String?           @map("closed_by_id") @db.Uuid
  /// Frozen at closing (and recalculated by corrections).
  expectedPiastres    Int?              @map("expected_piastres")
  countedPiastres     Int?              @map("counted_piastres")
  /// counted − expected: negative is a shortage.
  discrepancyPiastres Int?              @map("discrepancy_piastres")
  closingNote         String?           @map("closing_note") @db.VarChar(500)
  reviewStatus        CashReviewStatus? @map("review_status")
  reviewedById        String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  reviewNote          String?           @map("review_note") @db.VarChar(500)
  /// Bumped on every change, for optimistic concurrency.
  version             Int               @default(0)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  register     CashRegister?     @relation(fields: [registerId], references: [id], onDelete: SetNull)
  cashier      User?             @relation("CashShiftCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  closedBy     User?             @relation("CashShiftCloser", fields: [closedById], references: [id], onDelete: SetNull)
  reviewedBy   User?             @relation("CashShiftReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  transactions CashTransaction[]

  @@index([restaurantId, openedAt])
  @@index([branchId, status])
  @@index([cashierId, openedAt])
  @@index([registerId, status])
  @@map("cash_shifts")
}

/// A movement of cash in a shift's drawer. Payments and refunds of a bill carry a source key
/// (unique), so a retried or concurrent request is never counted twice.
model CashTransaction {
  id             String              @id @default(uuid()) @db.Uuid
  restaurantId   String              @map("restaurant_id") @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  shiftId        String              @map("shift_id") @db.Uuid
  kind           CashTransactionKind
  /// Positive, except ADJUSTMENT and CORRECTION which are signed.
  amountPiastres Int                 @map("amount_piastres")
  reason         String?             @db.VarChar(300)
  orderId        String?             @map("order_id") @db.Uuid
  /// "order:{id}:sale:{paidAt ms}" and the like; null for manual movements.
  sourceKey      String?             @unique @map("source_key") @db.VarChar(120)
  approvalStatus CashApprovalStatus  @default(APPROVED) @map("approval_status")
  approvedById   String?             @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?           @map("approved_at") @db.Timestamptz(3)
  createdById    String?             @map("created_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift      CashShift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy  User?      @relation("CashTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?      @relation("CashTransactionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([shiftId, createdAt])
  @@index([restaurantId, approvalStatus])
  @@index([orderId])
  @@map("cash_transactions")
}

// --- Shared table sessions ---------------------------------------------------------------------------

enum TableSessionStatus {
  ACTIVE
  /// The table asked for the bill: no new dishes until the staff reopen it.
  CLOSING
  CLOSED

  @@map("table_session_status")
}

enum TableSessionCloseReason {
  SETTLED
  EXPIRED
  STAFF

  @@map("table_session_close_reason")
}

enum TableCartItemStatus {
  DRAFT
  SUBMITTED

  @@map("table_cart_item_status")
}

/// One phone at the table. Its signed token (contracts TABLE_GUEST_HEADER) carries this id.
model TableGuest {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  /// 1, 2, 3... in the order they joined ("Guest 2" until they give a name).
  number      Int      @db.SmallInt
  displayName String?  @map("display_name") @db.VarChar(30)
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  session    TableSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cartItems  TableCartItem[]
  orderItems OrderItem[]

  @@unique([sessionId, number])
  @@map("table_guests")
}

/// A dish in a table session's shared order. Names and price are copied when added and checked again
/// when sent; a sent dish (SUBMITTED) belongs to an order and no longer changes here.
model TableCartItem {
  id                String              @id @default(uuid()) @db.Uuid
  sessionId         String              @map("session_id") @db.Uuid
  guestId           String              @map("guest_id") @db.Uuid
  menuItemId        String              @map("menu_item_id") @db.Uuid
  variantId         String              @map("variant_id") @db.Uuid
  nameAr            String              @map("name_ar") @db.VarChar(100)
  nameEn            String?             @map("name_en") @db.VarChar(100)
  variantNameAr     String?             @map("variant_name_ar") @db.VarChar(40)
  variantNameEn     String?             @map("variant_name_en") @db.VarChar(40)
  unitPricePiastres Int                 @map("unit_price_piastres")
  quantity          Int                 @db.SmallInt
  note              String?             @db.VarChar(200)
  status            TableCartItemStatus @default(DRAFT)
  orderId           String?             @map("order_id") @db.Uuid
  /// Bumped on every change, so two phones cannot overwrite each other.
  version           Int                 @default(0)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  submittedAt       DateTime?           @map("submitted_at") @db.Timestamptz(3)

  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guest   TableGuest   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  order   Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([sessionId, status])
  @@index([orderId])
  @@map("table_cart_items")
}
