  actorId      String?  @map("actor_id") @db.Uuid
  /// Set for a restaurant's own events (its staff changes), so its owner can read them.
  restaurantId String?  @map("restaurant_id") @db.Uuid
  action       String   @db.VarChar(60)
  targetType   String   @map("target_type") @db.VarChar(40)
  targetId     String?  @map("target_id") @db.VarChar(64)
  metadata     Json?
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([restaurantId, createdAt])
  @@map("audit_logs")
}

/// Sent expiry reminders, so each goes out once per period.
model ExpiryReminder {
